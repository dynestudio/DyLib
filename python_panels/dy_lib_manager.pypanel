# -----------------------------------------------------------------------
# CONSTANTS
# -----------------------------------------------------------------------

TITLE_LIB = "dy Library Manager"
DB_FILENAME = "dy_lib_manager_db.json"
DB_REMOTE_URL = f"https://raw.githubusercontent.com/cdordelly/dyLib/dev/{DB_FILENAME}"
IS_WINDOWS = platform.system() == "Windows"
SUBPROCESS_FLAGS = {"creationflags": subprocess.CREATE_NO_WINDOW} if IS_WINDOWS else {}

# -----------------------------------------------------------------------
# ICONS
# -----------------------------------------------------------------------

ICON_SEARCH = "BUTTONS_search"
ICON_SEARCH_CLEAR = "BUTTONS_remove"
ICON_REFRESH = "BUTTONS_cook"
ICON_FILTER = "BUTTONS_filter"
ICON_FOLDER = "BUTTONS_folder"
ICON_DOWNLOAD = "BUTTONS_auto_save"
ICON_REDOWNLOAD = "MISC_database"
ICON_FAVORITE = "BUTTONS_favorites"
ICON_TAG = "BUTTONS_tag"
ICON_LINK = "VIEW_visualization_global"

HIGHLIGHT_COLOR = "rgba(255, 170, 0, 80)"
HIGHLIGHT_COLOR_HOVER = "rgba(255, 170, 0, 120)"
TOOLBTN_STYLE = "QToolButton { border: none; padding: 2px; } QToolButton:hover { background-color: rgba(255, 255, 255, 30); }"

# -----------------------------------------------------------------------
# PATH HELPER
# -----------------------------------------------------------------------

def _fwd_path(p):
    return os.path.normpath(p).replace("\\", "/")

# -----------------------------------------------------------------------
# GIT UTILITY FUNCTIONS
# -----------------------------------------------------------------------

def is_git_installed():
    try:
        subprocess.run(["git", "--version"], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **SUBPROCESS_FLAGS)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False

def get_remote_branches(repository_url):
    result = subprocess.run(["git", "ls-remote", "--heads", repository_url], capture_output=True, text=True, **SUBPROCESS_FLAGS)
    branches = [line.split("refs/heads/")[1].strip() for line in result.stdout.splitlines() if "refs/heads/" in line]
    return branches

def get_remote_releases(url):
    try:
        owner, repo = parse_owner_repo(url)
        api_url = f"https://api.github.com/repos/{owner}/{repo}/releases"
        req = urllib.request.Request(api_url, headers={"Accept": "application/vnd.github.v3+json"})
        with urllib.request.urlopen(req, timeout=10) as response:
            releases_data = json.loads(response.read().decode("utf-8"))
            releases = []
            for release in releases_data:
                release_name = release.get("name") or release.get("tag_name")
                tag_name = release.get("tag_name")
                releases.append((release_name, tag_name))
            return releases
    except Exception as e:
        print(f"Error fetching releases: {e}")
        return get_remote_tags(url)

def get_remote_tags(repository_url):
    result = subprocess.run(["git", "ls-remote", "--tags", repository_url], capture_output=True, text=True, **SUBPROCESS_FLAGS)
    tags = [(line.split("refs/tags/")[1].strip(), line.split("refs/tags/")[1].strip())
            for line in result.stdout.splitlines()
            if "^{}" not in line and "refs/tags/" in line]
    return tags

def download_github_repository(url, destination, ref="master", is_release=False):
    if is_release:
        subprocess.run(["git", "clone", "--depth", "1", "--branch", ref, url, destination], **SUBPROCESS_FLAGS)
    else:
        subprocess.run(["git", "clone", "-b", ref, url, destination], **SUBPROCESS_FLAGS)

def git_pull(directory):
    subprocess.run(["git", "pull"], cwd=directory, **SUBPROCESS_FLAGS)

def git_checkout(directory, ref):
    subprocess.run(["git", "fetch", "--all"], cwd=directory, **SUBPROCESS_FLAGS)
    subprocess.run(["git", "checkout", ref], cwd=directory, **SUBPROCESS_FLAGS)

# -----------------------------------------------------------------------
# GITHUB API HELPER
# -----------------------------------------------------------------------

def parse_owner_repo(url):
    parts = url.split("github.com/")
    if len(parts) < 2:
        return None, None
    owner_repo = parts[1].replace(".git", "").strip("/")
    segments = owner_repo.split("/")
    if len(segments) >= 2:
        return segments[0], segments[1]
    return None, None

def get_repo_info_from_entry(lib_entry):
    url = lib_entry.get("url", "")
    fallback_name = Path(url).stem if url else "Unknown"
    return {
        "name": lib_entry.get("name") or fallback_name,
        "description": lib_entry.get("description") or "",
        "author": lib_entry.get("author") or "",
        "url": url.replace(".git", "").rstrip("/")
    }

# -----------------------------------------------------------------------
# DATABASE LOADING
# -----------------------------------------------------------------------

def load_database():
    local_path = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), DB_FILENAME)
    if os.path.isfile(local_path):
        with open(local_path, "r") as f:
            return json.load(f)
    # Download from remote
    try:
        print(f"Downloading library database from: {DB_REMOTE_URL}")
        with urllib.request.urlopen(DB_REMOTE_URL, timeout=15) as response:
            data = json.loads(response.read().decode("utf-8"))
            os.makedirs(os.path.dirname(local_path), exist_ok=True)
            with open(local_path, "w") as f:
                json.dump(data, f, indent=2)
            print(f"Database saved to: {local_path}")
            return data
    except Exception as e:
        print(f"Error downloading database: {e}")
        return None

def save_local_setting(key, value):
    local_path = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), DB_FILENAME)
    try:
        data = {}
        if os.path.isfile(local_path):
            with open(local_path, "r") as f:
                data = json.load(f)
        data[key] = value
        with open(local_path, "w") as f:
            json.dump(data, f, indent=2)
    except Exception as e:
        print(f"Error saving setting '{key}': {e}")

# -----------------------------------------------------------------------
# PACKAGE UTILITY FUNCTIONS
# -----------------------------------------------------------------------

def add_env_variable(env_list, key, value):
    env_list.append({key: value})

def add_path_variable(path_list, key):
    path_list.append(f"${key}")

def hou_reload_packages(lib_name, package_path):
    print(f"Installing: {lib_name}")
    spacer = "----------------"
    print(f"{spacer} Packages reload START {spacer}")
    load_msg = "Houdini's packages are reloading, wait until Houdini finish the reload process.\n\n"
    load_msg += "This will reload: Desktops, Digital Assets, Python modules, Python panels, Shelf tools, Viewer states, Viewer handles.\n"
    print(load_msg)
    try:
        with hou.InterruptableOperation("Reloading Houdini Packages", open_interrupt_dialog=True) as operation:
            print(f"Loading package: {package_path}")
            hou.ui.loadPackage(package_path)
            operation.updateProgress(1.0)
    except Exception as e:
        print(f"An error occurred: {e}")
    print(f"{spacer} Packages reload END {spacer}")
    print("The packages reload process is finished.")

# -----------------------------------------------------------------------
# STATUS DETECTION
# -----------------------------------------------------------------------

def get_repo_name(url):
    return Path(url).stem

def get_library_status(repo_name, packages_dir, install_root=None, create_package=True):
    if not create_package and install_root:
        expanded_root = hou.expandString(install_root)
        lib_dir = os.path.join(expanded_root, repo_name)
        if os.path.isdir(lib_dir):
            return "Installed", True, ""
        return "Not Installed", False, ""

    package_path = os.path.join(packages_dir, repo_name + ".json")
    if not os.path.isfile(package_path):
        return "Not Installed", False, package_path
    try:
        with open(package_path, "r") as f:
            data = json.load(f)
        enabled = data.get("enable", True)
        status = "Installed" if enabled else "Disabled"
        return status, enabled, package_path
    except Exception:
        return "Unknown", False, package_path

def resolve_unique_names(entries):
    name_counts = {}
    for entry in entries:
        name = entry["repo_name"]
        name_counts[name] = name_counts.get(name, 0) + 1
    for entry in entries:
        if name_counts[entry["repo_name"]] > 1:
            owner, _ = parse_owner_repo(entry["db"]["url"])
            if owner:
                entry["repo_name"] = f"{owner}-{entry['repo_name']}"

def _create_basic_package(lib_dir, package_key, houdini_packages_dir):
    data = {"enable": True, "env": [], "hpath": []}
    try:
        package_path_rel = os.path.relpath(lib_dir, houdini_packages_dir)
        relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
        add_env_variable(data["env"], package_key, relative_path)
    except Exception:
        add_env_variable(data["env"], package_key, lib_dir)
    add_path_variable(data["hpath"], package_key)
    return data

# -----------------------------------------------------------------------
# INSTALL LOGIC
# -----------------------------------------------------------------------

def install_library(lib_entry, install_root, repo_name, ref, is_release=False):
    url = lib_entry["url"]
    package_file = lib_entry.get("package_file")
    package_key = lib_entry.get("package_key") or repo_name.replace("-", "_")

    expanded_root = hou.expandString(install_root)
    lib_dir = os.path.join(expanded_root, repo_name)

    if os.path.isdir(lib_dir):
        print(f"Directory already exists: {lib_dir}")
        return False

    # Clone repository
    lib_dir_display = _fwd_path(lib_dir)
    print(f"Cloning {url} ({ref}) to {lib_dir_display}")
    try:
        with hou.InterruptableOperation(f"Downloading {repo_name}", open_interrupt_dialog=True) as operation:
            download_github_repository(url, lib_dir, ref, is_release)
            operation.updateProgress(1.0)
    except hou.OperationInterrupted:
        if os.path.isdir(lib_dir):
            shutil.rmtree(lib_dir, onerror=_remove_readonly)
        print(f"Download cancelled: {repo_name}")
        return False

    if not os.path.isdir(lib_dir):
        print(f"Clone failed: {lib_dir_display} not found")
        return False

    # Skip package creation if create_package is false
    if not lib_entry.get("create_package", True):
        print(f"Clone-only mode: no package created for {repo_name}")
        return True

    houdini_packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

    # Resolve effective library directory (subfolder support via lib_location)
    lib_location = lib_entry.get("lib_location", "")
    effective_lib_dir = os.path.join(lib_dir, lib_location) if lib_location else lib_dir

    # Search for the package file if one is specified in the DB
    found_files = []
    if package_file:
        found_files = glob.glob(os.path.join(lib_dir, "**", package_file), recursive=True)
        if not found_files:
            root_file = os.path.join(lib_dir, package_file)
            if os.path.isfile(root_file):
                found_files = [root_file]

    if found_files:
        source_package_path = os.path.normpath(found_files[0])
        try:
            with open(source_package_path, "r") as f:
                data = json.load(f)
        except Exception:
            print(f"Failed to parse {source_package_path}, creating basic package.")
            data = None

        if data and "env" in data:
            package_dir = os.path.dirname(source_package_path)
            # Use lib_location subfolder if the package file is at repo root
            if lib_location and package_dir == lib_dir:
                package_dir = effective_lib_dir
            for env_dict in data["env"]:
                if package_key in env_dict:
                    try:
                        package_path_rel = os.path.relpath(package_dir, houdini_packages_dir)
                        relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
                        env_dict[package_key] = relative_path
                        print(f"Library Path: {relative_path}")
                    except Exception:
                        env_dict[package_key] = package_dir
                        print(f"Library Path: {package_dir}")
                    break
            # Ensure "enable" is the first key
            if "enable" not in data:
                data = {"enable": True, **data}
            else:
                data = {"enable": data.pop("enable"), **data}
        else:
            data = _create_basic_package(effective_lib_dir, package_key, houdini_packages_dir)
    else:
        if package_file:
            print(f"Package file '{package_file}' not found, creating basic package.")
        else:
            print(f"No package file specified, creating basic package.")
        data = _create_basic_package(effective_lib_dir, package_key, houdini_packages_dir)

    # Save package to Houdini packages dir
    os.makedirs(houdini_packages_dir, exist_ok=True)
    dest_package_path = os.path.normpath(os.path.join(houdini_packages_dir, repo_name + ".json"))
    with open(dest_package_path, "w") as f:
        json.dump(data, f, indent=4)

    # Reload Houdini packages
    hou_reload_packages(repo_name, dest_package_path)
    return True

# -----------------------------------------------------------------------
# ENABLE / DISABLE
# -----------------------------------------------------------------------

def set_library_enabled(repo_name, packages_dir, enabled):
    package_path = os.path.join(packages_dir, repo_name + ".json")
    if not os.path.isfile(package_path):
        return False
    try:
        with open(package_path, "r") as f:
            data = json.load(f)
        # Rebuild with "enable" as the first key
        new_data = {"enable": enabled}
        for key, value in data.items():
            if key != "enable":
                new_data[key] = value
        with open(package_path, "w") as f:
            json.dump(new_data, f, indent=4)
        return True
    except Exception as e:
        print(f"Error toggling {repo_name}: {e}")
        return False

# -----------------------------------------------------------------------
# UNINSTALL
# -----------------------------------------------------------------------

def _remove_readonly(func, path, excinfo):
    os.chmod(path, stat.S_IWRITE)
    func(path)

def uninstall_library(repo_name, install_root, packages_dir):
    expanded_root = hou.expandString(install_root)
    lib_dir = os.path.join(expanded_root, repo_name)
    package_path = os.path.join(packages_dir, repo_name + ".json")
    removed = False
    if os.path.isdir(lib_dir):
        shutil.rmtree(lib_dir, onerror=_remove_readonly)
        print(f"Removed directory: {_fwd_path(lib_dir)}")
        removed = True
    if os.path.isfile(package_path):
        os.remove(package_path)
        print(f"Removed package: {_fwd_path(package_path)}")
        removed = True
    return removed

# -----------------------------------------------------------------------
# UI DIALOG
# -----------------------------------------------------------------------

COL_ENABLE = 0
COL_NAME = 1
COL_DESCRIPTION = 2
COL_AUTHOR = 3
COL_ACTION = 4
COLUMN_LABELS = ["", "Library", "Description", "Author", ""]

class LibManagerWidget(QtWidgets.QWidget):
    def __init__(self, parent=None):
        super(LibManagerWidget, self).__init__(parent)

        # Apply the Houdini style sheet
        self.setProperty("houdiniStyle", True)
        sh = hou.ui.qtStyleSheet()
        self.setStyleSheet(sh)

        self.setAttribute(QtCore.Qt.WA_DeleteOnClose)

        self._all_lib_data = []
        self._lib_data = []
        self._favorites = set()
        self._active_tags = set()
        self._last_install_path = ""

        # Main layout
        main_layout = QtWidgets.QVBoxLayout()
        self.setLayout(main_layout)

        # ---- Top bar: Libraries path ----
        path_layout = QtWidgets.QHBoxLayout()
        main_layout.addLayout(path_layout)

        path_label = QtWidgets.QLabel("Libraries Path:")
        path_layout.addWidget(path_label)

        self.path_field = QtWidgets.QLineEdit()
        self.path_field.setText("$HOUDINI_USER_PREF_DIR/_libs")
        self.path_field.editingFinished.connect(self._save_install_path)
        path_layout.addWidget(self.path_field)

        browse_btn = QtWidgets.QToolButton()
        browse_btn.setIcon(hou.qt.Icon(ICON_FOLDER))
        browse_btn.setToolTip("Browse")
        browse_btn.setAutoRaise(True)
        browse_btn.setStyleSheet(TOOLBTN_STYLE)
        browse_btn.clicked.connect(self.browse_path)
        path_layout.addWidget(browse_btn)

        # ---- Table ----
        self.table = QtWidgets.QTableWidget()
        self.table.setColumnCount(len(COLUMN_LABELS))
        self.table.setHorizontalHeaderLabels(COLUMN_LABELS)
        self.table.setSelectionBehavior(QtWidgets.QAbstractItemView.SelectRows)
        self.table.setSelectionMode(QtWidgets.QAbstractItemView.ExtendedSelection)
        self.table.setEditTriggers(QtWidgets.QAbstractItemView.NoEditTriggers)
        self.table.verticalHeader().setVisible(False)
        self.table.setContextMenuPolicy(QtCore.Qt.CustomContextMenu)
        self.table.customContextMenuRequested.connect(self.show_context_menu)
        self.table.setFocusPolicy(QtCore.Qt.ClickFocus)
        self.table.setAlternatingRowColors(True)
        self.table.setStyleSheet(
            "QHeaderView::section { font-weight: normal; }"
            "QTableWidget::item:selected { font-weight: normal; }"
            "QToolButton { border: none; padding: 2px; }"
            "QToolButton:hover { background-color: rgba(255, 255, 255, 30); }"
        )

        header = self.table.horizontalHeader()
        header.setHighlightSections(False)
        header.setSectionResizeMode(COL_ENABLE, QtWidgets.QHeaderView.ResizeToContents)
        header.setSectionResizeMode(COL_NAME, QtWidgets.QHeaderView.ResizeToContents)
        header.setSectionResizeMode(COL_DESCRIPTION, QtWidgets.QHeaderView.Stretch)
        header.setSectionResizeMode(COL_AUTHOR, QtWidgets.QHeaderView.ResizeToContents)
        header.setSectionResizeMode(COL_ACTION, QtWidgets.QHeaderView.ResizeToContents)
        for column in range(len(COLUMN_LABELS)):
            header_item = self.table.horizontalHeaderItem(column)
            if header_item is not None:
                header_font = header_item.font()
                header_font.setBold(False)
                header_item.setFont(header_font)

        main_layout.addWidget(self.table)

        # ---- Bottom bar ----
        bottom_layout = QtWidgets.QHBoxLayout()
        main_layout.addLayout(bottom_layout)

        filter_icon_label = QtWidgets.QLabel()
        filter_icon_label.setPixmap(hou.qt.Icon(ICON_FILTER).pixmap(16, 16))
        filter_icon_label.setToolTip("Filter")
        bottom_layout.addWidget(filter_icon_label)

        self.status_filter = QtWidgets.QComboBox()
        self.status_filter.addItems(["All", "Favorites", "Installed", "Not Installed", "Enabled", "Disabled", "Commercial", "Standalone"])
        self.status_filter.setFixedWidth(140)
        self.status_filter.currentIndexChanged.connect(self.apply_filter)
        bottom_layout.addWidget(self.status_filter)

        self.star_btn = QtWidgets.QToolButton()
        self.star_btn.setIcon(hou.qt.Icon(ICON_FAVORITE))
        self.star_btn.setToolTip("Show Favorites")
        self.star_btn.setAutoRaise(True)
        self.star_btn.setCheckable(True)
        self.star_btn.setStyleSheet(TOOLBTN_STYLE)
        self.star_btn.clicked.connect(self._on_star_clicked)
        bottom_layout.addWidget(self.star_btn)
        self._update_star_btn_style()

        self.tag_btn = QtWidgets.QToolButton()
        self.tag_btn.setIcon(hou.qt.Icon(ICON_TAG))
        self.tag_btn.setToolTip("Filter by Tag")
        self.tag_btn.setAutoRaise(True)
        self.tag_btn.setPopupMode(QtWidgets.QToolButton.InstantPopup)
        self.tag_btn.setStyleSheet(TOOLBTN_STYLE)
        self.tag_menu = QtWidgets.QMenu(self.tag_btn)
        self.tag_btn.setMenu(self.tag_menu)
        self.tag_menu.aboutToShow.connect(self._build_tag_menu)
        bottom_layout.addWidget(self.tag_btn)

        self.search_field = QtWidgets.QLineEdit()
        self.search_field.setPlaceholderText("Search libraries...")
        self.search_field.addAction(hou.qt.Icon(ICON_SEARCH), QtWidgets.QLineEdit.LeadingPosition)
        self._clear_action = self.search_field.addAction(hou.qt.Icon(ICON_SEARCH_CLEAR), QtWidgets.QLineEdit.TrailingPosition)
        self._clear_action.setVisible(False)
        self._clear_action.triggered.connect(lambda: self.search_field.clear())
        self.search_field.textChanged.connect(self._on_search_changed)
        bottom_layout.addWidget(self.search_field)

        bottom_layout.addStretch()

        redownload_btn = QtWidgets.QToolButton()
        redownload_btn.setIcon(hou.qt.Icon(ICON_REDOWNLOAD))
        redownload_btn.setToolTip("Redownload Database")
        redownload_btn.setAutoRaise(True)
        redownload_btn.setStyleSheet(TOOLBTN_STYLE)
        redownload_btn.clicked.connect(self.redownload_database)
        bottom_layout.addWidget(redownload_btn)

        refresh_btn = QtWidgets.QToolButton()
        refresh_btn.setIcon(hou.qt.Icon(ICON_REFRESH))
        refresh_btn.setToolTip("Refresh Database")
        refresh_btn.setAutoRaise(True)
        refresh_btn.setStyleSheet(TOOLBTN_STYLE)
        refresh_btn.clicked.connect(self.refresh_table)
        bottom_layout.addWidget(refresh_btn)

        # ---- Load data ----
        self.refresh_table()

    def _on_search_changed(self, text):
        self._clear_action.setVisible(bool(text))
        self.apply_filter()

    # -----------------------------------------------------------------------
    # PATH BROWSING
    # -----------------------------------------------------------------------

    def browse_path(self):
        directory = hou.ui.selectFile(
            start_directory=self.path_field.text(),
            title="Select Libraries Root Directory",
            file_type=hou.fileType.Directory,
            chooser_mode=hou.fileChooserMode.Read
        )
        if directory:
            self.path_field.setText(directory.replace("\\", "/").rstrip("/"))
            self._save_install_path()

    def _save_install_path(self):
        new_path = self.path_field.text().strip()
        if new_path == self._last_install_path:
            return
        old_path = self._last_install_path
        self._last_install_path = new_path
        save_local_setting("install_path", new_path)
        self._check_relocation(old_path, new_path)

    # -----------------------------------------------------------------------
    # FAVORITES
    # -----------------------------------------------------------------------

    def _on_star_clicked(self):
        if self.status_filter.currentText() == "Favorites":
            self.status_filter.setCurrentText("All")
        else:
            self.status_filter.setCurrentText("Favorites")

    def _toggle_favorite(self, rows):
        for r in rows:
            if r >= len(self._lib_data):
                continue
            url = self._lib_data[r]["db"].get("url", "")
            if not url:
                continue
            if url in self._favorites:
                self._favorites.discard(url)
            else:
                self._favorites.add(url)
        save_local_setting("favorites", list(self._favorites))
        if self.status_filter.currentText() == "Favorites":
            self.apply_filter()

    # -----------------------------------------------------------------------
    # TAGS
    # -----------------------------------------------------------------------

    def _collect_all_tags(self):
        tags = {tag for entry in self._all_lib_data for tag in entry["db"].get("tags", [])}
        return sorted(tags, key=str.casefold)

    def _build_tag_menu(self):
        self.tag_menu.clear()
        all_tags = self._collect_all_tags()

        if self._active_tags:
            clear_action = self.tag_menu.addAction("Clear All Tags")
            clear_action.triggered.connect(self._clear_tag_filter)
            self.tag_menu.addSeparator()

        for tag in all_tags:
            action = self.tag_menu.addAction(tag)
            action.setCheckable(True)
            action.setChecked(tag in self._active_tags)
            action.triggered.connect(lambda checked=False, t=tag: self._on_tag_toggled(t))

    def _on_tag_toggled(self, tag):
        if tag in self._active_tags:
            self._active_tags.discard(tag)
        else:
            self._active_tags.add(tag)
        self._update_tag_btn_style()
        self.apply_filter()

    def _clear_tag_filter(self):
        self._active_tags.clear()
        self._update_tag_btn_style()
        self.apply_filter()

    def _set_btn_highlight(self, btn, active):
        if active:
            btn.setStyleSheet(
                f"QToolButton {{ border: none; padding: 2px; background-color: {HIGHLIGHT_COLOR}; border-radius: 2px; }}"
                f"QToolButton:hover {{ background-color: {HIGHLIGHT_COLOR_HOVER}; }}"
            )
        else:
            btn.setStyleSheet(TOOLBTN_STYLE)

    def _update_star_btn_style(self):
        is_fav = self.status_filter.currentText() == "Favorites"
        self._set_btn_highlight(self.star_btn, is_fav)
        self.star_btn.setChecked(is_fav)

    def _update_tag_btn_style(self):
        active = bool(self._active_tags)
        self._set_btn_highlight(self.tag_btn, active)
        self.tag_btn.setToolTip("Tags: " + ", ".join(sorted(self._active_tags)) if active else "Filter by Tag")

    def _edit_tags_dialog(self, rows):
        if not rows:
            return
        entries = [self._lib_data[r] for r in rows if r < len(self._lib_data)]
        if not entries:
            return

        all_tags = self._collect_all_tags()

        # Find common tags across selected entries
        if len(entries) == 1:
            common_tags = set(entries[0]["db"].get("tags", []))
        else:
            common_tags = set(entries[0]["db"].get("tags", []))
            for entry in entries[1:]:
                common_tags &= set(entry["db"].get("tags", []))

        if len(entries) == 1:
            header_text = entries[0]["repo_info"]["name"]
        else:
            header_text = f"{len(entries)} libraries selected"

        dialog = QtWidgets.QDialog(self)
        dialog.setWindowTitle(header_text)
        dialog.setProperty("houdiniStyle", True)
        dialog.setStyleSheet(hou.ui.qtStyleSheet())
        dialog.setFixedSize(280, 340)

        main_layout = QtWidgets.QVBoxLayout(dialog)
        main_layout.setContentsMargins(12, 12, 12, 12)
        main_layout.setSpacing(8)

        # Tag list with alternating row colors
        tag_list = QtWidgets.QListWidget()
        tag_list.setAlternatingRowColors(True)
        tag_list.setFrameShape(QtWidgets.QFrame.Box)
        for tag in all_tags:
            item = QtWidgets.QListWidgetItem(tag)
            item.setFlags(item.flags() | QtCore.Qt.ItemIsUserCheckable)
            item.setCheckState(QtCore.Qt.Checked if tag in common_tags else QtCore.Qt.Unchecked)
            tag_list.addItem(item)
        main_layout.addWidget(tag_list, 1)

        # New tag input
        new_tag_layout = QtWidgets.QHBoxLayout()
        new_tag_layout.setSpacing(6)
        new_tag_field = QtWidgets.QLineEdit()
        new_tag_field.setPlaceholderText("New tag...")
        new_tag_layout.addWidget(new_tag_field)
        add_btn = QtWidgets.QPushButton("Add")
        add_btn.setFixedWidth(70)
        new_tag_layout.addWidget(add_btn)
        main_layout.addLayout(new_tag_layout)

        def add_new_tag():
            tag = new_tag_field.text().strip().lower().replace(" ", "_")
            if tag:
                # Check if tag already exists
                for i in range(tag_list.count()):
                    if tag_list.item(i).text() == tag:
                        tag_list.item(i).setCheckState(QtCore.Qt.Checked)
                        new_tag_field.clear()
                        return
                item = QtWidgets.QListWidgetItem(tag)
                item.setFlags(item.flags() | QtCore.Qt.ItemIsUserCheckable)
                item.setCheckState(QtCore.Qt.Checked)
                tag_list.addItem(item)
                new_tag_field.clear()

        add_btn.clicked.connect(add_new_tag)
        new_tag_field.returnPressed.connect(add_new_tag)

        # OK / Cancel
        btn_layout = QtWidgets.QHBoxLayout()
        btn_layout.setSpacing(6)
        btn_layout.addStretch()
        ok_btn = QtWidgets.QPushButton("OK")
        ok_btn.setMinimumWidth(70)
        cancel_btn = QtWidgets.QPushButton("Cancel")
        cancel_btn.setMinimumWidth(70)
        btn_layout.addWidget(ok_btn)
        btn_layout.addWidget(cancel_btn)
        main_layout.addLayout(btn_layout)

        ok_btn.clicked.connect(dialog.accept)
        cancel_btn.clicked.connect(dialog.reject)

        if dialog.exec_() != QtWidgets.QDialog.Accepted:
            return

        selected_tags = sorted([tag_list.item(i).text() for i in range(tag_list.count()) if tag_list.item(i).checkState() == QtCore.Qt.Checked])
        self._save_library_tags(entries, selected_tags)
        self.apply_filter()

    def _save_library_tags(self, entries, tags):
        local_path = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), DB_FILENAME)
        try:
            data = {}
            if os.path.isfile(local_path):
                with open(local_path, "r") as f:
                    data = json.load(f)

            # Build lookup by url + name for commercial entries
            db_libs = data.get("libraries", [])
            for entry in entries:
                url = entry["db"].get("url", "")
                name = entry["db"].get("name", "")
                for db_lib in db_libs:
                    if url and db_lib.get("url") == url:
                        db_lib["tags"] = tags
                        break
                    elif not url and db_lib.get("name") == name:
                        db_lib["tags"] = tags
                        break
                entry["db"]["tags"] = tags

            with open(local_path, "w") as f:
                json.dump(data, f, indent=2)
        except Exception as e:
            print(f"Error saving tags: {e}")

    # -----------------------------------------------------------------------
    # LIBRARY RELOCATION
    # -----------------------------------------------------------------------

    def _check_relocation(self, old_path, new_path):
        if not self._all_lib_data or not old_path:
            return

        old_expanded = hou.expandString(old_path)
        new_expanded = hou.expandString(new_path)

        if os.path.normcase(os.path.normpath(old_expanded)) == os.path.normcase(os.path.normpath(new_expanded)):
            return

        if not os.path.isdir(old_expanded):
            return

        # Find installed libraries at old location
        installed = []
        for entry in self._all_lib_data:
            if entry["status"] != "Not Installed":
                lib_dir = os.path.join(old_expanded, entry["repo_name"])
                if os.path.isdir(lib_dir):
                    installed.append(entry)

        if not installed:
            return

        names = "\n".join(f"  - {e['repo_name']}" for e in installed)
        count = len(installed)
        msg = (
            f"Found {count} installed {'libraries' if count > 1 else 'library'} "
            f"at the previous location:\n{names}\n\n"
            f"Move them to the new location?"
        )

        result = hou.ui.displayMessage(
            msg,
            buttons=("Move", "Leave in Place", "Cancel"),
            default_choice=0,
            close_choice=2,
            title="Library Relocation",
            severity=hou.severityType.ImportantMessage
        )

        if result == 2:
            # Cancel — revert path change
            self.path_field.setText(old_path)
            self._last_install_path = old_path
            save_local_setting("install_path", old_path)
            return

        if result == 0:
            self._relocate_libraries(installed, old_expanded, new_expanded)

        self.refresh_table()

    def _relocate_libraries(self, entries, old_root, new_root):
        os.makedirs(new_root, exist_ok=True)
        packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

        moved = 0
        errors = []

        try:
            with hou.InterruptableOperation("Moving libraries", open_interrupt_dialog=True) as operation:
                for i, entry in enumerate(entries):
                    repo_name = entry["repo_name"]
                    old_dir = os.path.join(old_root, repo_name)
                    new_dir = os.path.join(new_root, repo_name)

                    if os.path.exists(new_dir):
                        errors.append(f"{repo_name}: already exists at destination")
                        continue

                    try:
                        shutil.move(old_dir, new_dir)
                        print(f"Moved: {_fwd_path(old_dir)} -> {_fwd_path(new_dir)}")

                        # Update package file paths
                        pkg_path = os.path.join(packages_dir, repo_name + ".json")
                        if os.path.isfile(pkg_path):
                            self._update_package_paths(pkg_path, old_root, new_root, packages_dir)

                        moved += 1
                    except Exception as e:
                        errors.append(f"{repo_name}: {e}")

                    operation.updateProgress(float(i + 1) / len(entries))
        except hou.OperationInterrupted:
            pass

        summary = f"Moved {moved}/{len(entries)} libraries."
        if errors:
            summary += "\n\nErrors:\n" + "\n".join(errors)
        print(summary)
        if errors:
            hou.ui.displayMessage(summary, severity=hou.severityType.Warning, title="Library Relocation")

    def _update_package_paths(self, pkg_path, old_root, new_root, packages_dir):
        try:
            with open(pkg_path, "r") as f:
                data = json.load(f)

            if "env" not in data:
                return

            old_root_n = os.path.normpath(old_root)
            modified = False

            for env_dict in data["env"]:
                for key in list(env_dict.keys()):
                    value = env_dict[key]
                    if not isinstance(value, str) or "$HOUDINI_PACKAGE_PATH" not in value:
                        continue

                    # Resolve $HOUDINI_PACKAGE_PATH to absolute path
                    suffix = value[len("$HOUDINI_PACKAGE_PATH"):].lstrip("/")
                    resolved = os.path.normpath(os.path.join(packages_dir, suffix))

                    # Check if resolved path falls under the old install root
                    try:
                        rel = os.path.relpath(resolved, old_root_n)
                    except ValueError:
                        continue  # Different drives on Windows
                    if rel.startswith(".."):
                        continue  # Not under old_root

                    # Build new path and convert back to $HOUDINI_PACKAGE_PATH relative
                    new_abs = os.path.normpath(os.path.join(new_root, rel))
                    new_rel = os.path.relpath(new_abs, packages_dir)
                    env_dict[key] = "$HOUDINI_PACKAGE_PATH/" + new_rel.replace("\\", "/")
                    modified = True

            if modified:
                with open(pkg_path, "w") as f:
                    json.dump(data, f, indent=4)
                print(f"Updated package: {_fwd_path(pkg_path)}")
        except Exception as e:
            print(f"Error updating package {_fwd_path(pkg_path)}: {e}")

    # -----------------------------------------------------------------------
    # DATABASE
    # -----------------------------------------------------------------------

    def redownload_database(self):
        local_path = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), DB_FILENAME)
        current_path = self.path_field.text().strip()
        current_favorites = list(self._favorites)

        # Collect local tag overrides before redownloading
        local_tags = {}
        for entry in self._all_lib_data:
            tags = entry["db"].get("tags", [])
            if tags:
                key = entry["db"].get("url") or entry["db"].get("name", "")
                if key:
                    local_tags[key] = tags

        try:
            if os.path.isfile(local_path):
                os.remove(local_path)
            print(f"Redownloading database from: {DB_REMOTE_URL}")
            with urllib.request.urlopen(DB_REMOTE_URL, timeout=15) as response:
                data = json.loads(response.read().decode("utf-8"))
                if current_path:
                    data["install_path"] = current_path
                if current_favorites:
                    data["favorites"] = current_favorites

                # Merge local tag overrides back into fresh data
                if local_tags:
                    for lib in data.get("libraries", []):
                        key = lib.get("url") or lib.get("name", "")
                        if key in local_tags:
                            lib["tags"] = local_tags[key]

                os.makedirs(os.path.dirname(local_path), exist_ok=True)
                with open(local_path, "w") as f:
                    json.dump(data, f, indent=2)
            print(f"Database saved to: {_fwd_path(local_path)}")
            self.refresh_table()
        except Exception as e:
            hou.ui.displayMessage(f"Failed to redownload database:\n{e}", severity=hou.severityType.Error, title=TITLE_LIB)

    # -----------------------------------------------------------------------
    # TABLE POPULATION
    # -----------------------------------------------------------------------

    def refresh_table(self):
        self.table.clearContents()
        self.table.setRowCount(0)
        self._all_lib_data = []
        self._lib_data = []

        db = load_database()
        if not db:
            hou.ui.displayMessage("Failed to load the library database.", severity=hou.severityType.Error, title=TITLE_LIB)
            return

        # Load persisted install path
        install_path = db.get("install_path")
        if install_path:
            self.path_field.setText(install_path)
        self._last_install_path = self.path_field.text()

        # Load favorites
        self._favorites = set(db.get("favorites", []))

        libraries = db.get("libraries", [])
        packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

        for lib_entry in libraries:
            is_commercial = lib_entry.get("commercial", False)
            url = lib_entry.get("url", "")
            repo_name = lib_entry.get("name", "") if is_commercial else get_repo_name(url)
            repo_info = get_repo_info_from_entry(lib_entry)
            entry = {
                "db": lib_entry,
                "repo_info": repo_info,
                "repo_name": repo_name,
                "status": "Commercial" if is_commercial else "Not Installed",
                "enabled": False,
                "package_path": "",
            }
            self._all_lib_data.append(entry)

        # Disambiguate duplicate repo names before checking status
        resolve_unique_names(self._all_lib_data)

        # Check status with resolved names
        current_install_root = self.path_field.text()
        for entry in self._all_lib_data:
            if entry["db"].get("commercial", False):
                continue
            create_pkg = entry["db"].get("create_package", True)
            status, enabled, pkg_path = get_library_status(
                entry["repo_name"], packages_dir,
                install_root=current_install_root if not create_pkg else None,
                create_package=create_pkg
            )
            entry["status"] = status
            entry["enabled"] = enabled
            entry["package_path"] = pkg_path

        # Discover standalone packages (not in DB)
        known_names = {e["repo_name"] for e in self._all_lib_data}
        if os.path.isdir(packages_dir):
            for fname in os.listdir(packages_dir):
                if not fname.endswith(".json"):
                    continue
                pkg_name = fname[:-5]  # strip .json
                if pkg_name in known_names:
                    continue
                pkg_path = os.path.join(packages_dir, fname)
                try:
                    with open(pkg_path, "r") as f:
                        pkg_data = json.load(f)
                except Exception:
                    continue
                enabled = pkg_data.get("enable", True)
                entry = {
                    "db": {"url": "", "tags": ["standalone"]},
                    "repo_info": {
                        "name": pkg_name,
                        "description": "",
                        "author": "",
                        "url": "",
                    },
                    "repo_name": pkg_name,
                    "status": "Installed" if enabled else "Disabled",
                    "enabled": enabled,
                    "package_path": pkg_path,
                    "standalone": True,
                }
                self._all_lib_data.append(entry)

        self._all_lib_data.sort(
            key=lambda item: (item["repo_info"].get("name") or item["repo_name"]).casefold()
        )
        self.apply_filter()

    def apply_filter(self, _=None):
        filter_text = self.search_field.text().strip().casefold()
        status_filter = self.status_filter.currentText()

        # Sync star button with filter dropdown
        if hasattr(self, "star_btn"):
            self._update_star_btn_style()

        filtered = list(self._all_lib_data)

        # Apply status filter
        if status_filter == "Favorites":
            filtered = [e for e in filtered if e["db"].get("url", "") in self._favorites]
        elif status_filter == "Installed":
            filtered = [e for e in filtered if e["status"] in ("Installed", "Disabled")]
        elif status_filter == "Not Installed":
            filtered = [e for e in filtered if e["status"] == "Not Installed"]
        elif status_filter == "Enabled":
            filtered = [e for e in filtered if e["status"] == "Installed"]
        elif status_filter == "Disabled":
            filtered = [e for e in filtered if e["status"] == "Disabled"]
        elif status_filter == "Commercial":
            filtered = [e for e in filtered if e["status"] == "Commercial"]
        elif status_filter == "Standalone":
            filtered = [e for e in filtered if e.get("standalone", False)]

        # Apply tag filter (stackable with status filter)
        if self._active_tags:
            filtered = [e for e in filtered if self._active_tags & set(e["db"].get("tags", []))]

        # Apply text search filter
        if filter_text:
            text_filtered = []
            for entry in filtered:
                repo_info = entry["repo_info"]
                searchable_parts = [
                    repo_info.get("name", ""),
                    repo_info.get("description", ""),
                    repo_info.get("author", ""),
                    entry.get("repo_name", ""),
                    entry["db"].get("url", ""),
                    " ".join(entry["db"].get("tags", [])),
                ]
                searchable_text = " ".join(part for part in searchable_parts if part).casefold()
                if filter_text in searchable_text:
                    text_filtered.append(entry)
            filtered = text_filtered

        self._lib_data = filtered
        self.populate_table()

    def populate_table(self):
        self.table.setRowCount(0)
        self.table.setRowCount(len(self._lib_data))

        for row, entry in enumerate(self._lib_data):
            is_commercial = entry["db"].get("commercial", False)

            # Enable checkbox
            chk_widget = QtWidgets.QWidget()
            chk_layout = QtWidgets.QHBoxLayout(chk_widget)
            chk_layout.setAlignment(QtCore.Qt.AlignCenter)
            chk_layout.setContentsMargins(0, 0, 0, 0)
            chk = QtWidgets.QCheckBox()
            chk.setChecked(entry["enabled"])
            create_pkg = entry["db"].get("create_package", True)
            chk.setEnabled(entry["status"] not in ("Not Installed", "Commercial") and create_pkg)
            if not is_commercial:
                chk.stateChanged.connect(lambda state, r=row: self.on_enable_toggled(r, state))
            chk_layout.addWidget(chk)
            self.table.setCellWidget(row, COL_ENABLE, chk_widget)

            # Name
            name_item = QtWidgets.QTableWidgetItem(entry["repo_info"]["name"])
            self.table.setItem(row, COL_NAME, name_item)

            # Description
            desc = entry["repo_info"]["description"]
            desc_item = QtWidgets.QTableWidgetItem(desc)
            desc_item.setToolTip(desc)
            self.table.setItem(row, COL_DESCRIPTION, desc_item)

            # Author
            author_item = QtWidgets.QTableWidgetItem(entry["repo_info"]["author"])
            self.table.setItem(row, COL_AUTHOR, author_item)

            # Action
            if is_commercial:
                action_btn = QtWidgets.QToolButton()
                action_btn.setIcon(hou.qt.Icon(ICON_LINK))
                action_btn.setToolTip("Open Product Page")
                action_btn.setAutoRaise(True)
                url = entry["repo_info"].get("url", "")
                action_btn.clicked.connect(lambda _=None, u=url: webbrowser.open(u))
                self.table.setCellWidget(row, COL_ACTION, action_btn)
            elif entry["status"] == "Not Installed":
                action_btn = QtWidgets.QToolButton()
                action_btn.setIcon(hou.qt.Icon(ICON_DOWNLOAD))
                action_btn.setToolTip("Install")
                action_btn.setAutoRaise(True)
                action_btn.clicked.connect(lambda _=None, r=row: self.on_install_clicked(r))
                self.table.setCellWidget(row, COL_ACTION, action_btn)
            else:
                dash_item = QtWidgets.QTableWidgetItem("")
                self.table.setItem(row, COL_ACTION, dash_item)

    # -----------------------------------------------------------------------
    # ENABLE / DISABLE TOGGLE
    # -----------------------------------------------------------------------

    def on_enable_toggled(self, row, state):
        enabled = state == QtCore.Qt.Checked.value if hasattr(QtCore.Qt.Checked, "value") else state == QtCore.Qt.Checked

        # Determine which rows to toggle (multi-select support)
        selected_rows = sorted(set(index.row() for index in self.table.selectionModel().selectedRows()))
        if row in selected_rows and len(selected_rows) > 1:
            rows_to_toggle = [r for r in selected_rows if r < len(self._lib_data) and self._lib_data[r]["status"] != "Not Installed"]
        else:
            rows_to_toggle = [row]

        self._batch_enable(rows_to_toggle, enabled)

    def _batch_enable(self, rows, enabled):
        packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")
        action_label = "Enabling" if enabled else "Disabling"
        try:
            with hou.InterruptableOperation(f"{action_label} packages", open_interrupt_dialog=True) as operation:
                for i, r in enumerate(rows):
                    entry = self._lib_data[r]
                    set_library_enabled(entry["repo_name"], packages_dir, enabled)
                    entry["enabled"] = enabled
                    entry["status"] = "Installed" if enabled else "Disabled"

                    # Update checkbox without re-triggering signal
                    chk_widget = self.table.cellWidget(r, COL_ENABLE)
                    if chk_widget:
                        chk = chk_widget.findChild(QtWidgets.QCheckBox)
                        if chk:
                            chk.blockSignals(True)
                            chk.setChecked(enabled)
                            chk.blockSignals(False)

                    # Update the current Houdini session
                    package_path = entry["package_path"]
                    try:
                        if enabled:
                            hou.ui.activatePackage(package_path)
                        else:
                            hou.ui.deactivatePackage(package_path)
                    except Exception as e:
                        print(f"Session update error for {entry['repo_name']}: {e}")

                    operation.updateProgress(float(i + 1) / len(rows))
        except hou.OperationInterrupted:
            pass

    # -----------------------------------------------------------------------
    # INSTALL
    # -----------------------------------------------------------------------

    def on_install_clicked(self, row):
        if not is_git_installed():
            hou.ui.displayMessage("Git is not installed. Opening download page.", severity=hou.severityType.Error, title="Git Required")
            webbrowser.open("https://git-scm.com/downloads")
            return

        # Check for multi-selection
        selected_rows = sorted(set(index.row() for index in self.table.selectionModel().selectedRows()))
        if row in selected_rows and len(selected_rows) > 1:
            rows_to_install = [r for r in selected_rows if r < len(self._lib_data) and self._lib_data[r]["status"] == "Not Installed"]
        else:
            rows_to_install = [row]

        for r in rows_to_install:
            self._install_single(r)

        self.refresh_table()

    def _install_single(self, row):
        entry = self._lib_data[row]
        lib_entry = entry["db"]
        url = lib_entry["url"]
        repo_name = entry["repo_name"]

        # Check releases availability first
        releases = get_remote_releases(url)
        is_release = False

        if releases:
            # Repo has releases — ask user what to download
            download_type = hou.ui.displayMessage(
                "What would you like to download?",
                buttons=('Clone Branch', 'Release', 'Cancel'),
                severity=hou.severityType.Message,
                default_choice=0,
                close_choice=2,
                title=repo_name
            )
            if download_type == 2:
                return
            is_release = download_type == 1

        if is_release:
            display_items = [name for name, _ in releases]
            item_index = hou.ui.selectFromList(
                display_items,
                default_choices=([0]),
                exclusive=1,
                message="Select the release to install:",
                title=repo_name,
                column_header="Releases",
                num_visible_rows=10,
                clear_on_cancel=True,
                width=0, height=0,
                sort=False,
                condense_paths=False
            )
            if not item_index:
                return
            selected = releases[item_index[0]][1]  # tag name
        else:
            branches = get_remote_branches(url)
            if not branches:
                hou.ui.displayMessage("No branches found.", severity=hou.severityType.Error, title="Error")
                return

            if len(branches) == 1:
                selected = branches[0]
                print(f"Only one branch available: {selected}")
            else:
                default_choice = 0
                if "master" in branches:
                    default_choice = branches.index("master")
                elif "main" in branches:
                    default_choice = branches.index("main")

                item_index = hou.ui.selectFromList(
                    branches,
                    default_choices=([default_choice]),
                    exclusive=1,
                    message="Select the branch to install:",
                    title=repo_name,
                    column_header="Branches",
                    num_visible_rows=10,
                    clear_on_cancel=True,
                    width=0, height=0,
                    sort=False,
                    condense_paths=False
                )
                if not item_index:
                    return
                selected = branches[item_index[0]]

        install_root = self.path_field.text()
        success = install_library(lib_entry, install_root, repo_name, selected, is_release)
        if success:
            hou.ui.displayMessage(f"{repo_name} installed successfully.", title=TITLE_LIB)

    # -----------------------------------------------------------------------
    # RIGHT-CLICK CONTEXT MENU
    # -----------------------------------------------------------------------

    def show_context_menu(self, pos):
        selected_rows = sorted(set(index.row() for index in self.table.selectionModel().selectedRows()))
        clicked_row = self.table.rowAt(pos.y())

        if not selected_rows:
            if clicked_row < 0 or clicked_row >= len(self._lib_data):
                return
            selected_rows = [clicked_row]

        entries = [(r, self._lib_data[r]) for r in selected_rows if r < len(self._lib_data)]
        if not entries:
            return

        menu = QtWidgets.QMenu(self)
        is_single = len(entries) == 1

        if is_single:
            row, entry = entries[0]
            is_commercial = entry["db"].get("commercial", False)
            is_standalone = entry.get("standalone", False)

            if is_standalone:
                # Standalone: enable/disable and edit tags only
                if entry["status"] in ("Installed", "Disabled"):
                    toggle_label = "Disable" if entry["enabled"] else "Enable"
                    toggle_action = menu.addAction(toggle_label)
                    toggle_action.triggered.connect(lambda: self._batch_enable([row], not entry["enabled"]))

                menu.addSeparator()
                tags_action = menu.addAction("Edit Tags")
                tags_action.triggered.connect(lambda: self._edit_tags_dialog([row]))
            else:
                # Open in Browser
                open_browser = menu.addAction("Open in Browser")
                open_browser.triggered.connect(lambda: webbrowser.open(entry["repo_info"]["url"]))

                if not is_commercial:
                    # Favorite toggle
                    is_fav = entry["db"].get("url", "") in self._favorites
                    fav_label = "Remove from Favorites" if is_fav else "Add to Favorites"
                    fav_action = menu.addAction(fav_label)
                    fav_action.triggered.connect(lambda: self._toggle_favorite([row]))

                # Edit Tags
                menu.addSeparator()
                tags_action = menu.addAction("Edit Tags")
                tags_action.triggered.connect(lambda: self._edit_tags_dialog([row]))

                if not is_commercial and entry["status"] != "Not Installed":
                    # Open Directory
                    open_dir = menu.addAction("Open Directory")
                    open_dir.triggered.connect(lambda: self.open_directory(row))

                    menu.addSeparator()

                    # Library Info
                    info_action = menu.addAction("Library Info")
                    info_action.triggered.connect(lambda: self.show_library_info(row))

                    menu.addSeparator()

                    # Force Update
                    update_action = menu.addAction("Force Update")
                    update_action.triggered.connect(lambda: self.force_update(row))

                    # Switch Branch
                    switch_branch_action = menu.addAction("Switch Branch")
                    switch_branch_action.triggered.connect(lambda: self.switch_version(row, is_release=False))

                    # Switch Release
                    switch_release_action = menu.addAction("Switch Release")
                    switch_release_action.triggered.connect(lambda: self.switch_version(row, is_release=True))

                    menu.addSeparator()

                    # Uninstall
                    uninstall_action = menu.addAction("Uninstall")
                    uninstall_action.triggered.connect(lambda: self.on_uninstall([row]))

                elif not is_commercial and entry["status"] == "Not Installed":
                    menu.addSeparator()
                    install_action = menu.addAction("Install")
                    install_action.triggered.connect(lambda: self.on_install_clicked(row))

        else:
            # Multi-selection context menu
            all_rows = [r for r, _ in entries]
            fav_action = menu.addAction("Toggle Favorites")
            fav_action.triggered.connect(lambda: self._toggle_favorite(all_rows))

            # Edit Tags (multi)
            tags_action = menu.addAction("Edit Tags")
            tags_action.triggered.connect(lambda: self._edit_tags_dialog(all_rows))
            menu.addSeparator()

            installed_rows = [r for r, e in entries if e["status"] not in ("Not Installed", "Commercial")]
            not_installed_rows = [r for r, e in entries if e["status"] == "Not Installed"]
            # Exclude standalone from uninstall (they are not managed by DyLib)
            uninstallable_rows = [r for r in installed_rows if not self._lib_data[r].get("standalone", False)]

            if installed_rows:
                enable_action = menu.addAction("Enable Selected")
                enable_action.triggered.connect(lambda: self._batch_enable(installed_rows, True))

                disable_action = menu.addAction("Disable Selected")
                disable_action.triggered.connect(lambda: self._batch_enable(installed_rows, False))

            if uninstallable_rows:
                menu.addSeparator()

                uninstall_action = menu.addAction("Uninstall Selected")
                uninstall_action.triggered.connect(lambda: self.on_uninstall(uninstallable_rows))

            if not_installed_rows:
                if installed_rows:
                    menu.addSeparator()
                install_action = menu.addAction("Install Selected")
                install_action.triggered.connect(lambda: self._install_multiple(not_installed_rows))

        menu.exec_(self.table.viewport().mapToGlobal(pos))

    def show_library_info(self, row):
        entry = self._lib_data[row]
        expanded_root = hou.expandString(self.path_field.text())
        lib_dir = os.path.join(expanded_root, entry["repo_name"])
        if not os.path.isdir(lib_dir):
            hou.ui.displayMessage(f"Directory not found:\n{lib_dir}", severity=hou.severityType.Error, title="Library Info")
            return

        def _git_query(args):
            try:
                result = subprocess.run(
                    ["git"] + args, cwd=lib_dir,
                    capture_output=True, text=True, **SUBPROCESS_FLAGS
                )
                return result.stdout.strip() if result.returncode == 0 else ""
            except Exception:
                return ""

        branch = _git_query(["rev-parse", "--abbrev-ref", "HEAD"])
        tag = _git_query(["describe", "--tags", "--exact-match"])
        commit_date = _git_query(["log", "-1", "--format=%ci"])
        remote_url = _git_query(["remote", "get-url", "origin"])
        installed_date = datetime.fromtimestamp(os.path.getctime(lib_dir)).strftime("%Y-%m-%d")

        # HEAD means detached (e.g. checked out a tag/release)
        if branch == "HEAD":
            branch = ""

        lines = []
        lines.append(f"Library Name:   {entry['repo_info']['name']}")
        if branch:
            lines.append(f"Branch:   {branch}")
        if tag:
            lines.append(f"Tag:   {tag}")
        if remote_url:
            lines.append(f"Repository:   {remote_url}")
        if commit_date:
            lines.append(f"Last Commit:   {commit_date}")
        lines.append(f"Local Path:   {_fwd_path(lib_dir)}")
        lines.append(f"Installed:   {installed_date}")

        hou.ui.displayMessage(
            "\n".join(lines),
            title=f"Library Info - {entry['repo_info']['name']}",
            severity=hou.severityType.Message
        )

    def open_directory(self, row):
        entry = self._lib_data[row]
        expanded_root = hou.expandString(self.path_field.text())
        lib_dir = os.path.join(expanded_root, entry["repo_name"])
        if os.path.isdir(lib_dir):
            if IS_WINDOWS:
                os.startfile(lib_dir)
            else:
                subprocess.Popen(["xdg-open", lib_dir])
        else:
            hou.ui.displayMessage(f"Directory not found:\n{lib_dir}", severity=hou.severityType.Error, title="Error")

    def _install_multiple(self, rows):
        if not is_git_installed():
            hou.ui.displayMessage("Git is not installed. Opening download page.", severity=hou.severityType.Error, title="Git Required")
            webbrowser.open("https://git-scm.com/downloads")
            return
        for r in rows:
            if r < len(self._lib_data) and self._lib_data[r]["status"] == "Not Installed":
                self._install_single(r)
        self.refresh_table()

    def force_update(self, row):
        entry = self._lib_data[row]
        expanded_root = hou.expandString(self.path_field.text())
        lib_dir = os.path.join(expanded_root, entry["repo_name"])
        if not os.path.isdir(lib_dir):
            hou.ui.displayMessage(f"Install directory not found:\n{lib_dir}", severity=hou.severityType.Error, title="Update Error")
            return
        print(f"Updating {entry['repo_name']}...")
        git_pull(lib_dir)
        hou.ui.displayMessage(f"{entry['repo_name']} updated.", title=TITLE_LIB)

    def switch_version(self, row, is_release=False):
        entry = self._lib_data[row]
        url = entry["db"]["url"]

        if is_release:
            items = get_remote_releases(url)
            if not items:
                hou.ui.displayMessage("No releases found.", severity=hou.severityType.Warning, title="Switch Release")
                return
            display_items = [name for name, _ in items]
        else:
            items = get_remote_branches(url)
            if not items:
                hou.ui.displayMessage("No branches found.", severity=hou.severityType.Warning, title="Switch Branch")
                return
            display_items = items

        column_header = "Releases" if is_release else "Branches"
        item_index = hou.ui.selectFromList(
            display_items,
            default_choices=([0]),
            exclusive=1,
            message=f"Select {'release' if is_release else 'branch'} to switch to:",
            title=entry["repo_name"],
            column_header=column_header,
            num_visible_rows=10,
            clear_on_cancel=True,
            sort=False
        )
        if not item_index:
            return

        selected = items[item_index[0]]
        if is_release:
            selected = items[item_index[0]][1]

        expanded_root = hou.expandString(self.path_field.text())
        lib_dir = os.path.join(expanded_root, entry["repo_name"])
        if not os.path.isdir(lib_dir):
            hou.ui.displayMessage(f"Install directory not found:\n{lib_dir}", severity=hou.severityType.Error, title="Switch Error")
            return

        print(f"Switching {entry['repo_name']} to {selected}...")
        git_checkout(lib_dir, selected)
        hou.ui.displayMessage(f"{entry['repo_name']} switched to {selected}.", title=TITLE_LIB)

    def on_uninstall(self, rows):
        if not rows:
            return
        names = ", ".join(self._lib_data[r]["repo_name"] for r in rows if r < len(self._lib_data))
        count = len(rows)
        msg = f"Uninstall {names}?\n\nThis will delete the library files and the Houdini {'packages' if count > 1 else 'package'}."
        confirm = hou.ui.displayMessage(
            msg,
            buttons=("Cancel", "Uninstall"),
            severity=hou.severityType.ImportantMessage,
            default_choice=0,
            close_choice=0,
            title="Confirm Uninstall"
        )
        if confirm != 1:
            return

        install_root = self.path_field.text()
        packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")
        for r in rows:
            if r < len(self._lib_data):
                uninstall_library(self._lib_data[r]["repo_name"], install_root, packages_dir)
        self.refresh_table()

def onCreateInterface():
    return LibManagerWidget()
