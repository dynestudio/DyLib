  <tool name="dy_install_lib" label="Install Library" icon="hicon:/SVGIcons.index?DESKTOP_installer2.svg">
    <script scriptType="python"><![CDATA[# INSTALL LIBRARY
import hou
import json
import os
import platform

# -----------------------------------------------------------------------

def add_env_variable(env_list, key, value):
    env_list.append({key: value})

def add_path_variable(path_list, key):
    path_list.append(f"${key}")

def hou_reload_packages(lib_name, package_path):
    print (f"Installing: {lib_name}")
    spacer = "----------------"
    print (f"{spacer} Packages reload START {spacer}")
    load_msg = "Houdini's packages are reloading, wait until Houdini finish the reload process.\n\n"
    load_msg += "This will reload: Desktops, Digital Assets, Python modules, Python panels, Shelf tools, Viewer states, Viewer handles.\n"
    print (load_msg)

    try:
        with hou.InterruptableOperation(
            "Reloading Houdini Packages", open_interrupt_dialog=True
        ) as operation:
            print(f"Loading package: {package_path}")
            hou.ui.loadPackage(package_path)
            operation.updateProgress(1.0)  # Indicate that the operation is complete
    except Exception as e:
        print(f"An error occurred: {e}")

    print (f"{spacer} Packages reload END {spacer}")
    print ("The packages reload process is finished.")

# -----------------------------------------------------------------------

lib_name = hou.ui.readInput(message = "Library Name:",
                       buttons=('OK',),
                       severity=hou.severityType.Message,
                       default_choice=0,
                       close_choice=-1,
                       help=None,
                       title=None,
                       initial_contents=None)[1]

if not lib_name:
    exit()

lib_dir = hou.ui.selectFile(start_directory=None,
                        title=None,
                        collapse_sequences=False,
                        file_type=hou.fileType.Directory,
                        pattern=None,
                        default_value=None,
                        multiple_select=False,
                        image_chooser=None,
                        chooser_mode=hou.fileChooserMode.Read,
                        width=0, height=0)

if not lib_dir:
    exit()

# -----------------------------------------------------------------------

# Create the JSON package structure
data = {
    "enable": True,
    "env": [],
    "hpath": []
}

# Define the directory path
lib_path = hou.expandString(lib_dir)

# Add environment variables
# Check if the package path can be relative to the Houdini packages directory
houdini_packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")
try:
    package_path_rel = os.path.relpath(lib_path, houdini_packages_dir)
    relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
    add_env_variable(data["env"], lib_name, relative_path)
    print(f"Library Path: {relative_path}")
except:
    add_env_variable(data["env"], lib_name, lib_path)
    print(f"Library Path: {lib_path}")

# Add path variable
add_path_variable(data["hpath"], lib_name)

# -----------------------------------------------------------------------

# Define the directory path
directory = houdini_packages_dir

# Create the directory if it doesn't exist
if not os.path.exists(directory):
    os.makedirs(directory)

# Define the file path
package_path = os.path.join(directory, lib_name + ".json")

# Normalize the path
package_path = os.path.normpath(package_path)

# Write the JSON data to a file
with open(package_path, "w") as f:
    json.dump(data, f, indent=4)

# -----------------------------------------------------------------------

# RELOAD HOUDINI PACKAGES
hou_reload_packages(lib_name, package_path)
exit()
# RESTART HOUDINI
if hou.ui.displayMessage("Do you want to restart Houdini?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=0,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):
    
    if platform.system() == 'Windows':
        os.system("taskkill /F /IM houdini.exe && start houdini.exe")
    else:
        print ("The restart feature works only in Windows.\nYou need to restart manually.")
else:
    print ("A library was installed, you must restart Houdini in order to use it.")]]></script>
  </tool>

  <tool name="dy_install_lib_json" label="Library from JSON" icon="hicon:/SVGIcons.index?DESKTOP_installer.svg">
    <script scriptType="python"><![CDATA[# LIBRARY FROM JSON
import hou
import json
import os
import platform

# -----------------------------------------------------------------------

def hou_reload_packages(lib_name, package_path):
    print (f"Installing: {lib_name}")
    spacer = "----------------"
    print (f"{spacer} Packages reload START {spacer}")
    load_msg = "Houdini's packages are reloading, wait until Houdini finish the reload process.\n\n"
    load_msg += "This will reload: Desktops, Digital Assets, Python modules, Python panels, Shelf tools, Viewer states, Viewer handles.\n"
    print (load_msg)

    try:
        with hou.InterruptableOperation(
            "Reloading Houdini Packages", open_interrupt_dialog=True
        ) as operation:
            print(f"Loading package: {package_path}")
            hou.ui.loadPackage(package_path)
            operation.updateProgress(1.0)  # Indicate that the operation is complete
    except Exception as e:
        print(f"An error occurred: {e}")

    print (f"{spacer} Packages reload END {spacer}")
    print ("The packages reload process is finished.")

# -----------------------------------------------------------------------

package_path = hou.ui.selectFile(start_directory=None,
                        title=None,
                        collapse_sequences=False,
                        file_type=hou.fileType.Any,
                        pattern="*.json",
                        default_value=None,
                        multiple_select=False,
                        image_chooser=None,
                        chooser_mode=hou.fileChooserMode.Read,
                        width=0, height=0)

if not package_path:
    exit()

package_path = hou.expandString(package_path)

# Read the package file
with open(package_path, "r") as f:
    try:
        data = json.load(f)
    except:
        print("The .json file could not be loaded.\nMight be an unexpected comma or another error on it.")
        exit()

# Package dir
package_path = os.path.dirname(package_path)

# Get the keys from the "env" list
env_keys = []
for env_dict in data["env"]:
    for key in env_dict.keys():
        env_keys.append(key)

if not env_keys:
    exit()

# Select the variable that defines the library path
var_index = hou.ui.selectFromList(env_keys,
                             default_choices=(),
                             exclusive=1,
                             message="Select the variable that defines the library path:",
                             title=None,
                             column_header="Variables",
                             num_visible_rows=10,
                             clear_on_cancel=True,
                             width=0, height=0,
                             sort=False,
                             condense_paths=False)

if not var_index:
    exit()

# Update memory package before save it
var = env_keys[var_index[0]]

# Check if the package path can be relative to the Houdini packages directory
houdini_packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")
try:
    package_path_rel = os.path.relpath(package_path, houdini_packages_dir)
    relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
    data["env"][var_index[0]][var] = relative_path
    print(f"Library Path: {relative_path}")
except:
    # Use the absolute path for paths that are too far from packages dir
    data["env"][var_index[0]][var] = package_path
    print(f"Library Path: {package_path}")

# -----------------------------------------------------------------------

# Define the directory path
directory = houdini_packages_dir

# Create the directory if it doesn't exist
if not os.path.exists(directory):
    os.makedirs(directory)

# Define the file path
package_path = os.path.join(directory, var + ".json")

# Normalize the path
package_path = os.path.normpath(package_path)

# Write the JSON data to a file
with open(package_path, "w") as f:
    json.dump(data, f, indent=4)

# -----------------------------------------------------------------------

# RELOAD HOUDINI PACKAGES
hou_reload_packages(var, package_path)
exit()
# RESTART HOUDINI
if hou.ui.displayMessage("Do you want to restart Houdini?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=0,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):
    
    if platform.system() == 'Windows':
        os.system("taskkill /F /IM houdini.exe && start houdini.exe")
    else:
        print ("The restart feature works only in Windows.\nYou need to restart manually.")
else:
    print ("A library was installed, you must restart Houdini in order to use it.")]]></script>
  </tool>

  <tool name="dy_install_lib_github" label="Library from GitHub" icon="hicon:/SVGIcons.index?BUTTONS_download.svg">
    <script scriptType="python"><![CDATA[# LIBRARY FROM GITHUB
import hou
import webbrowser
import subprocess
import os
from pathlib import Path
import glob
import json
import platform
import requests

# -----------------------------------------------------------------------

def is_git_installed():
    try:
        # Run the 'git --version' command to check if git exist
        subprocess.run(["git", "--version"], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, creationflags=subprocess.CREATE_NO_WINDOW)
        return True
    except subprocess.CalledProcessError:
        # If the command fails, Git is not installed
        return False

def get_remote_branches(repository_url):
    # Run the 'git ls-remote' command to get the branches
    result = subprocess.run(["git", "ls-remote", "--heads", repository_url], capture_output=True, text=True, creationflags=subprocess.CREATE_NO_WINDOW)
    
    # Parse the output to extract branch names
    branches = [line.split("refs/heads/")[1].strip() for line in result.stdout.splitlines()]
    
    return branches

def get_remote_releases(repository_url):
    # Parse the owner and repo from the URL
    try:
        # Extract owner/repo from github URL
        parts = repository_url.split('github.com/')
        if len(parts) < 2:
            return []
            
        owner_repo = parts[1].replace('.git', '')
        owner, repo = owner_repo.split('/')
        
        # Use the GitHub API to get releases
        api_url = f"https://api.github.com/repos/{owner}/{repo}/releases"
        
        response = requests.get(api_url)
        
        if response.status_code == 200:
            releases_data = response.json()
            # Extract release names and tags
            releases = []
            for release in releases_data:
                # Use name if available, otherwise use tag_name
                release_name = release.get("name") or release.get("tag_name")
                tag_name = release.get("tag_name")
                releases.append((release_name, tag_name))
            return releases
        else:
            print(f"Failed to fetch releases: HTTP {response.status_code}")
            # Fall back to git command if API fails
            return get_remote_tags(repository_url)
    except Exception as e:
        print(f"Error fetching releases: {str(e)}")
        # Fall back to git command if there's an error
        return get_remote_tags(repository_url)

def get_remote_tags(repository_url):
    # Run the 'git ls-remote' command to get the tags
    result = subprocess.run(["git", "ls-remote", "--tags", repository_url], capture_output=True, text=True, creationflags=subprocess.CREATE_NO_WINDOW)
    
     # Parse the output to extract tag names
    tags = [(line.split("refs/tags/")[1].strip(), line.split("refs/tags/")[1].strip()) 
            for line in result.stdout.splitlines() 
            if "^{}" not in line and "refs/tags/" in line]
    
    return tags

def download_github_repository(url, destination, ref="master", is_release=False):
    if is_release:
        # Clone the repository with the specific tag
        subprocess.run(["git", "clone", "--depth", "1", "--branch", ref, url, destination])
    else:
        # Clone the repository with the specific branch (your existing code)
        subprocess.run(["git", "clone", "-b", ref, url, destination])

def add_env_variable(env_list, key, value):
    env_list.append({key: value})

def add_path_variable(path_list, key):
    path_list.append(f"${key}")

def hou_reload_packages(lib_name, package_path):
    print (f"Installing: {lib_name}")
    spacer = "----------------"
    print (f"{spacer} Packages reload START {spacer}")
    load_msg = "Houdini's packages are reloading, wait until Houdini finish the reload process.\n\n"
    load_msg += "This will reload: Desktops, Digital Assets, Python modules, Python panels, Shelf tools, Viewer states, Viewer handles.\n"
    print (load_msg)

    try:
        with hou.InterruptableOperation(
            "Reloading Houdini Packages", open_interrupt_dialog=True
        ) as operation:
            print(f"Loading package: {package_path}")
            hou.ui.loadPackage(package_path)
            operation.updateProgress(1.0)  # Indicate that the operation is complete
    except Exception as e:
        print(f"An error occurred: {e}")

    print (f"{spacer} Packages reload END {spacer}")
    print ("The packages reload process is finished.")

# -----------------------------------------------------------------------

# Check if Git is installed
if not is_git_installed():
    print("Git needs to be installed.")
    url = "https://git-scm.com/downloads"
    webbrowser.open(url)
    exit()

dylib_repo_url = "https://github.com/dynestudio/DyLib.git"

# Repository URL
repo_url = hou.ui.readInput(message = "Repository Clone URL:",
                       buttons=('OK',),
                       severity=hou.severityType.Message,
                       default_choice=0,
                       close_choice=-1,
                       help=None,
                       title=None,
                       initial_contents=None)[1]

if not repo_url:
    exit()

# Check if Clone URL is valid
repo_extension = Path(repo_url).suffix
if not repo_extension or repo_extension != ".git":
    print("You need to use a valid URL Clone link.")
    exit()

# Get the filename without extension
repo_name = Path(repo_url).stem

# UI Select Download type
download_type = hou.ui.displayMessage(
    "What would you like to download?",
    buttons=('Clone Branch', 'Release'),
    severity=hou.severityType.Message,
    default_choice=0,
    close_choice=-1,
    title=repo_name
)

# Get items from Branches or Releases
items = get_remote_branches(repo_url) if download_type == 0 else get_remote_releases(repo_url)
is_release = download_type != 0
column_header = "Branches" if not is_release else "Releases"

if len(items)==0 and column_header == "Releases":
    print("No Repository Releases found, switching to Branches")
    items = get_remote_branches(repo_url)
    is_release = 0

# Set default selection
default_choice = 0
if not is_release:  # For branches, prefer master/main
    if "master" in items:
        default_choice = items.index("master")
    elif "main" in items:
        default_choice = items.index("main")

# Prepare items for display
display_items = items if not is_release else [name for name, _ in items]
selection_message = f"Select the {'branch' if not is_release else 'release'} to download:"

# Show selection dialog
item_index = hou.ui.selectFromList(
    display_items,
    default_choices=([default_choice]),
    exclusive=1,
    message=selection_message,
    title=repo_name,
    column_header=column_header,
    num_visible_rows=10,
    clear_on_cancel=True,
    width=0, height=0,
    sort=False,
    condense_paths=False
)

if not item_index:
    exit()

# Get selected item
selected_item = items[item_index[0]]
if is_release:
    selected_item = items[item_index[0]][1]  # Get tag name for releases

# Ask for destination directory
lib_dir = hou.ui.selectFile(start_directory=None,
                        title=None,
                        collapse_sequences=False,
                        file_type=hou.fileType.Directory,
                        pattern=None,
                        default_value=None,
                        multiple_select=False,
                        image_chooser=None,
                        chooser_mode=hou.fileChooserMode.Read,
                        width=0, height=0)

if not lib_dir:
    exit()

lib_dir = os.path.join(hou.expandString(lib_dir), repo_name)

# Download repository
download_github_repository(repo_url, lib_dir, selected_item, is_release=is_release)

# -----------------------------------------------------------------------

houdini_packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

#json_files = glob.glob(os.path.normpath(os.path.join(lib_dir, '*.json')))
json_files = glob.glob(os.path.join(lib_dir, '**', '*.json'), recursive=True)

# CREATE JSON PACKAGE FROM REPO
if json_files:
    json_files_names = [Path(file).name for file in json_files]
    json_files_packages_candidates = hou.ui.selectFromList(json_files_names,
                                default_choices=(),
                                exclusive=1,
                                message="Select the .json file that will be used as installation package:",
                                title=repo_name,
                                column_header="Candidates",
                                num_visible_rows=10,
                                clear_on_cancel=True,
                                width=0, height=0,
                                sort=False,
                                condense_paths=False)

    if not json_files_packages_candidates:
        exit()

    package_path = os.path.normpath( json_files[json_files_packages_candidates[0]] )
    package_path = Path(package_path).as_posix()

    # Read the package file
    with open(package_path, "r") as f:
        try:
            data = json.load(f)
            data_json_loaded = True
        except:
            print("The .json file could not be loaded.\nMight be an unexpected comma or another error on it.")
            print("A basic .json package file will be created pointing to the downloaded directory.")
            data_json_loaded = False

    if data_json_loaded:
        # Package dir
        package_path = os.path.dirname(package_path)

        # Get the keys from the "env" list
        env_keys = []
        for env_dict in data["env"]:
            for key in env_dict.keys():
                env_keys.append(key)

        if not env_keys:
            exit()

        # Select the variable that defines the library path
        var_index = hou.ui.selectFromList(env_keys,
                                    default_choices=(),
                                    exclusive=1,
                                    message="Select the variable that defines the library path:",
                                    title=None,
                                    column_header="Variables",
                                    num_visible_rows=10,
                                    clear_on_cancel=True,
                                    width=0, height=0,
                                    sort=False,
                                    condense_paths=False)

        if not var_index:
            exit()

        # Update memory package before save it
        var = env_keys[var_index[0]]

        # Check if the package path can be relative to the Houdini packages directory
        try:
            package_path_rel = os.path.relpath(package_path, houdini_packages_dir)
            relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
            data["env"][var_index[0]][var] = relative_path
            print(f"Library Path: {relative_path}")
        except:
            data["env"][var_index[0]][var] = package_path
            print(f"Library Path: {package_path}")

    else:
        # Create the JSON package structure
        data = {
            "enable": True,
            "env": [],
            "hpath": []
        }
        # Add environment variables
        # Check if the package path can be relative to the Houdini packages directory
        try:
            package_path_rel = os.path.relpath(lib_dir, houdini_packages_dir)
            relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
            add_env_variable(data["env"], repo_name.replace("-", "_"), relative_path)
            print(f"Library Path: {relative_path}")
        except:
            add_env_variable(data["env"], repo_name.replace("-", "_"), lib_dir)
            print(f"Library Path: {lib_dir}")
        # Add path variable
        add_path_variable(data["hpath"], repo_name.replace("-", "_"))

# CREATE PACKAGE MANUALLY
else:
    print("JSON Package File couldn't be found, creating a Package File")
    # Create the JSON package structure
    data = {
        "enable": True,
        "env": [],
        "hpath": []
    }
    # Add environment variables
    # Check if the package path can be relative to the Houdini packages directory
    try:
        package_path_rel = os.path.relpath(lib_dir, houdini_packages_dir)
        relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
        add_env_variable(data["env"], repo_name.replace("-", "_"), relative_path)
        print(f"Library Path: {relative_path}")
    except:
        add_env_variable(data["env"], repo_name.replace("-", "_"), lib_dir)
        print(f"Library Path: {lib_dir}")
    # Add path variable
    add_path_variable(data["hpath"], repo_name.replace("-", "_"))

# -----------------------------------------------------------------------

# Define the directory path
directory = houdini_packages_dir

# Create the directory if it doesn't exist
if not os.path.exists(directory):
    os.makedirs(directory)

# Define the file path
package_path = os.path.join(directory, repo_name + ".json")

# Normalize the path
package_path = os.path.normpath(package_path)

# Write the JSON data to a file
with open(package_path, "w") as f:
    json.dump(data, f, indent=4)

# -----------------------------------------------------------------------

# RELOAD HOUDINI PACKAGES
hou_reload_packages(repo_name, package_path)
exit()
# RESTART HOUDINI
if hou.ui.displayMessage("Do you want to restart Houdini?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=0,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):
    
    if platform.system() == 'Windows':
        os.system("taskkill /F /IM houdini.exe && start houdini.exe")
    else:
        print ("The restart feature works only in Windows.\nYou need to restart manually.")
else:
    print ("A library was installed, you must restart Houdini in order to use it.")]]></script>
