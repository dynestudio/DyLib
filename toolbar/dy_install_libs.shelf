  <tool name="dy_install_lib" label="Install Library" icon="hicon:/SVGIcons.index?DESKTOP_installer2.svg">
    <script scriptType="python"><![CDATA[import hou
import json
import os
import platform

# -----------------------------------------------------------------------

def add_env_variable(env_list, key, value):
    env_list.append({key: value})

def add_path_variable(path_list, key):
    path_list.append(f"${key}")

def hou_reload_packages(lib_name, package_path):
    print (f"Installing: {lib_name}")
    spacer = "----------------"
    print (f"{spacer} Packages reload START {spacer}")
    load_msg = "Houdini's packages are reloading, wait until Houdini finish the reload process.\n\n"
    load_msg += "This will reload: Desktops, Digital Assets, Python modules, Python panels, Shelf tools, Viewer states, Viewer handles.\n"
    print (load_msg)

    try:
        with hou.InterruptableOperation(
            "Reloading Houdini Packages", open_interrupt_dialog=True
        ) as operation:
            print(f"Loading package: {package_path}")
            hou.ui.loadPackage(package_path)
            operation.updateProgress(1.0)  # Indicate that the operation is complete
    except Exception as e:
        print(f"An error occurred: {e}")

    print (f"{spacer} Packages reload END {spacer}")
    print ("The packages reload process is finished.")

# -----------------------------------------------------------------------

lib_name = hou.ui.readInput(message = "Library Name:",
                       buttons=('OK',),
                       severity=hou.severityType.Message,
                       default_choice=0,
                       close_choice=-1,
                       help=None,
                       title=None,
                       initial_contents=None)[1]

if not lib_name:
    exit()

lib_dir = hou.ui.selectFile(start_directory=None,
                        title=None,
                        collapse_sequences=False,
                        file_type=hou.fileType.Directory,
                        pattern=None,
                        default_value=None,
                        multiple_select=False,
                        image_chooser=None,
                        chooser_mode=hou.fileChooserMode.Read,
                        width=0, height=0)

if not lib_dir:
    exit()

# -----------------------------------------------------------------------

# Create the JSON package structure
data = {
    "enable": True,
    "env": [],
    "path": []
}

# Add environment variables
add_env_variable(data["env"], lib_name, lib_dir)

# Add path variable
add_path_variable(data["path"], lib_name)

# -----------------------------------------------------------------------

# Define the directory path
directory = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

# Create the directory if it doesn't exist
if not os.path.exists(directory):
    os.makedirs(directory)

# Define the file path
package_path = os.path.join(directory, lib_name + ".json")

# Normalize the path
package_path = os.path.normpath(package_path)

# Write the JSON data to a file
with open(package_path, "w") as f:
    json.dump(data, f, indent=4)

# -----------------------------------------------------------------------

# RELOAD HOUDINI PACKAGES
hou_reload_packages(lib_name, package_path)
exit()
# RESTART HOUDINI
if hou.ui.displayMessage("Do you want to restart Houdini?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=0,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):
    
    if platform.system() == 'Windows':
        os.system("taskkill /F /IM houdini.exe && start houdini.exe")
    else:
        print ("The restart feature works only in Windows.\nYou need to restart manually.")
else:
    print ("A library was installed, you must restart Houdini in order to use it.")]]></script>
  </tool>

  <tool name="dy_install_lib_json" label="Library from Json" icon="hicon:/SVGIcons.index?DESKTOP_installer.svg">
    <script scriptType="python"><![CDATA[import hou
import json
import os
import platform

# -----------------------------------------------------------------------

def hou_reload_packages(lib_name, package_path):
    print (f"Installing: {lib_name}")
    spacer = "----------------"
    print (f"{spacer} Packages reload START {spacer}")
    load_msg = "Houdini's packages are reloading, wait until Houdini finish the reload process.\n\n"
    load_msg += "This will reload: Desktops, Digital Assets, Python modules, Python panels, Shelf tools, Viewer states, Viewer handles.\n"
    print (load_msg)

    try:
        with hou.InterruptableOperation(
            "Reloading Houdini Packages", open_interrupt_dialog=True
        ) as operation:
            print(f"Loading package: {package_path}")
            hou.ui.loadPackage(package_path)
            operation.updateProgress(1.0)  # Indicate that the operation is complete
    except Exception as e:
        print(f"An error occurred: {e}")

    print (f"{spacer} Packages reload END {spacer}")
    print ("The packages reload process is finished.")

# -----------------------------------------------------------------------

package_path = hou.ui.selectFile(start_directory=None,
                        title=None,
                        collapse_sequences=False,
                        file_type=hou.fileType.Any,
                        pattern="*.json",
                        default_value=None,
                        multiple_select=False,
                        image_chooser=None,
                        chooser_mode=hou.fileChooserMode.Read,
                        width=0, height=0)

if not package_path:
    exit()

package_path = hou.expandString(package_path)

# Read the package file
with open(package_path, "r") as f:
    try:
        data = json.load(f)
    except:
        print("The .json file could not be loaded.\nMight be an unexpected comma or another error on it.")
        exit()

# Package dir
package_path = os.path.dirname(package_path)

# Get the keys from the "env" list
env_keys = []
for env_dict in data["env"]:
    for key in env_dict.keys():
        env_keys.append(key)

if not env_keys:
    exit()

# Select the variable that defines the library path
var_index = hou.ui.selectFromList(env_keys,
                             default_choices=(),
                             exclusive=1,
                             message="Select the variable that defines the library path:",
                             title=None,
                             column_header="Variables",
                             num_visible_rows=10,
                             clear_on_cancel=True,
                             width=0, height=0,
                             sort=False,
                             condense_paths=False)

if not var_index:
    exit()

# Update memory package before save it
var = env_keys[var_index[0]]
data["env"][var_index[0]][var] = package_path

# -----------------------------------------------------------------------

# Define the directory path
directory = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

# Create the directory if it doesn't exist
if not os.path.exists(directory):
    os.makedirs(directory)

# Define the file path
package_path = os.path.join(directory, var + ".json")

# Normalize the path
package_path = os.path.normpath(package_path)

# Write the JSON data to a file
with open(package_path, "w") as f:
    json.dump(data, f, indent=4)

# -----------------------------------------------------------------------

# RELOAD HOUDINI PACKAGES
hou_reload_packages(var, package_path)
exit()
# RESTART HOUDINI
if hou.ui.displayMessage("Do you want to restart Houdini?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=0,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):
    
    if platform.system() == 'Windows':
        os.system("taskkill /F /IM houdini.exe && start houdini.exe")
    else:
        print ("The restart feature works only in Windows.\nYou need to restart manually.")
else:
    print ("A library was installed, you must restart Houdini in order to use it.")]]></script>
  </tool>

  <tool name="dy_install_lib_github" label="Library from Github" icon="hicon:/SVGIcons.index?BUTTONS_download.svg">
    <script scriptType="python"><![CDATA[import hou
import webbrowser
import subprocess
import os
from pathlib import Path
import glob
import json
import platform

# -----------------------------------------------------------------------

def is_git_installed():
    try:
        # Run the 'git --version' command to check if git exist
        subprocess.run(["git", "--version"], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, creationflags=subprocess.CREATE_NO_WINDOW)
        return True
    except subprocess.CalledProcessError:
        # If the command fails, Git is not installed
        return False

def get_remote_branches(repository_url):
    # Run the 'git ls-remote' command to get the branches
    result = subprocess.run(["git", "ls-remote", "--heads", repository_url], capture_output=True, text=True, creationflags=subprocess.CREATE_NO_WINDOW)
    
    # Parse the output to extract branch names
    branches = [line.split("refs/heads/")[1].strip() for line in result.stdout.splitlines()]
    
    return branches

def download_github_repository(url, destination, branch="master"):
    # Clone the repository to the destination folder with the specified branch
    subprocess.run(["git", "clone", "-b", branch, url, destination])

def add_env_variable(env_list, key, value):
    env_list.append({key: value})

def add_path_variable(path_list, key):
    path_list.append(f"${key}")

def hou_reload_packages(lib_name, package_path):
    print (f"Installing: {lib_name}")
    spacer = "----------------"
    print (f"{spacer} Packages reload START {spacer}")
    load_msg = "Houdini's packages are reloading, wait until Houdini finish the reload process.\n\n"
    load_msg += "This will reload: Desktops, Digital Assets, Python modules, Python panels, Shelf tools, Viewer states, Viewer handles.\n"
    print (load_msg)

    try:
        with hou.InterruptableOperation(
            "Reloading Houdini Packages", open_interrupt_dialog=True
        ) as operation:
            print(f"Loading package: {package_path}")
            hou.ui.loadPackage(package_path)
            operation.updateProgress(1.0)  # Indicate that the operation is complete
    except Exception as e:
        print(f"An error occurred: {e}")

    print (f"{spacer} Packages reload END {spacer}")
    print ("The packages reload process is finished.")

# -----------------------------------------------------------------------

# Check if Git is installed
if not is_git_installed():
    print("Git needs to be installed.")
    url = "https://git-scm.com/downloads"
    webbrowser.open(url)
    exit()

dylib_repo_url = "https://github.com/dynestudio/DyLib.git"

repo_url = hou.ui.readInput(message = "Repository Clone URL:",
                       buttons=('OK',),
                       severity=hou.severityType.Message,
                       default_choice=0,
                       close_choice=-1,
                       help=None,
                       title=None,
                       initial_contents=None)[1]

if not repo_url:
    exit()

# Check if Clone URL is valid
repo_extension = Path(repo_url).suffix
if not repo_extension or repo_extension != ".git":
    print("You need to use a valid URL Clone link.")
    exit()

# Get the filename without extension
repo_name = Path(repo_url).stem

# Select which branch download
branches = get_remote_branches(repo_url)

# Select the variable that defines the library path
branch_index = hou.ui.selectFromList(branches,
                             default_choices=([branches.index("master")]),
                             exclusive=1,
                             message="Select the branch to download:",
                             title=repo_name,
                             column_header="Branches",
                             num_visible_rows=10,
                             clear_on_cancel=True,
                             width=0, height=0,
                             sort=False,
                             condense_paths=False)

if not branch_index:
    exit()

branch = branches[branch_index[0]]

lib_dir = hou.ui.selectFile(start_directory=None,
                        title=None,
                        collapse_sequences=False,
                        file_type=hou.fileType.Directory,
                        pattern=None,
                        default_value=None,
                        multiple_select=False,
                        image_chooser=None,
                        chooser_mode=hou.fileChooserMode.Read,
                        width=0, height=0)

if not lib_dir:
    exit()

lib_dir = os.path.join(hou.expandString(lib_dir), repo_name)

download_github_repository(repo_url, lib_dir, branch)

# -----------------------------------------------------------------------

json_files = glob.glob(os.path.normpath(os.path.join(lib_dir, '*.json')))

# CREATE JSON PACKAGE FROM REPO
if json_files:
    json_files_names = [Path(file).name for file in json_files]
    json_files_packages_candidates = hou.ui.selectFromList(json_files_names,
                                default_choices=(),
                                exclusive=1,
                                message="Select the .json file that will be used as installation package:",
                                title=repo_name,
                                column_header="Candidates",
                                num_visible_rows=10,
                                clear_on_cancel=True,
                                width=0, height=0,
                                sort=False,
                                condense_paths=False)

    if not json_files_packages_candidates:
        exit()

    package_path = os.path.normpath( json_files[json_files_packages_candidates[0]] )
    package_path = Path(package_path).as_posix()

    # Read the package file
    with open(package_path, "r") as f:
        try:
            data = json.load(f)
            data_json_loaded = True
        except:
            print("The .json file could not be loaded.\nMight be an unexpected comma or another error on it.")
            print("A basic .json package file will be created pointing to the downloaded directory.")
            data_json_loaded = False

    if data_json_loaded:
        # Package dir
        package_path = os.path.dirname(package_path)

        # Get the keys from the "env" list
        env_keys = []
        for env_dict in data["env"]:
            for key in env_dict.keys():
                env_keys.append(key)

        if not env_keys:
            exit()

        # Select the variable that defines the library path
        var_index = hou.ui.selectFromList(env_keys,
                                    default_choices=(),
                                    exclusive=1,
                                    message="Select the variable that defines the library path:",
                                    title=None,
                                    column_header="Variables",
                                    num_visible_rows=10,
                                    clear_on_cancel=True,
                                    width=0, height=0,
                                    sort=False,
                                    condense_paths=False)

        if not var_index:
            exit()

        # Update memory package before save it
        var = env_keys[var_index[0]]
        data["env"][var_index[0]][var] = package_path

    else:
        # Create the JSON package structure
        data = {
            "enable": True,
            "env": [],
            "path": []
        }
        # Add environment variables
        add_env_variable(data["env"], repo_name, lib_dir)
        # Add path variable
        add_path_variable(data["path"], repo_name)

# CREATE PACKAGE MANUALLY
else:
    # Create the JSON package structure
    data = {
        "enable": True,
        "env": [],
        "path": []
    }
    # Add environment variables
    add_env_variable(data["env"], repo_name, lib_dir)
    # Add path variable
    add_path_variable(data["path"], repo_name)

# -----------------------------------------------------------------------

# Define the directory path
directory = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

# Create the directory if it doesn't exist
if not os.path.exists(directory):
    os.makedirs(directory)

# Define the file path
package_path = os.path.join(directory, repo_name + ".json")

# Normalize the path
package_path = os.path.normpath(package_path)

# Write the JSON data to a file
with open(package_path, "w") as f:
    json.dump(data, f, indent=4)

# -----------------------------------------------------------------------

# RELOAD HOUDINI PACKAGES
hou_reload_packages(repo_name, package_path)
exit()
# RESTART HOUDINI
if hou.ui.displayMessage("Do you want to restart Houdini?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=0,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):
    
    if platform.system() == 'Windows':
        os.system("taskkill /F /IM houdini.exe && start houdini.exe")
    else:
        print ("The restart feature works only in Windows.\nYou need to restart manually.")
else:
    print ("A library was installed, you must restart Houdini in order to use it.")]]></script>
  </tool>

  <tool name="dy_create_lib" label="Create Library" icon="hicon:/SVGIcons.index?BUTTONS_addassetdirectory.svg">
    <script scriptType="python"><![CDATA[import json
import os
import hou

# -----------------------------------------------------------------------

def add_env_variable(env_list, key, value):
    env_list.append({key: value})

def add_path_variable(path_list, key):
    path_list.append(f"${key}")

# -----------------------------------------------------------------------

lib_name = hou.ui.readInput(message = "Library Name:",
                       buttons=('OK',),
                       severity=hou.severityType.Message,
                       default_choice=0,
                       close_choice=-1,
                       help=None,
                       title=None,
                       initial_contents=None)[1]

if not lib_name:
    exit()

lib_dir = hou.ui.selectFile(start_directory=None,
                        title=None,
                        collapse_sequences=False,
                        file_type=hou.fileType.Directory,
                        pattern=None,
                        default_value=None,
                        multiple_select=False,
                        image_chooser=None,
                        chooser_mode=hou.fileChooserMode.Read,
                        width=0, height=0)

if not lib_dir:
    exit()

# -----------------------------------------------------------------------

# Define the directory path
lib_path = hou.expandString(os.path.join(lib_dir, lib_name))

# Create the directory if it doesn't exist
if not os.path.exists(lib_path):
    os.makedirs(lib_path)

lib_root_folders = ["config", "examples", "gallery", "otls", "presets", "scripts", "toolbar"]

# Select the variable that defines the library path
folders_index = hou.ui.selectFromList(lib_root_folders,
                             default_choices=(1,3,5,6),
                             exclusive=False,
                             message="Select the variable that defines the library path:",
                             title=None,
                             column_header="Variables",
                             num_visible_rows=10,
                             clear_on_cancel=True,
                             width=0, height=0,
                             sort=False,
                             condense_paths=False)

if not folders_index:
    exit()

# -----------------------------------------------------------------------

# Create library folders
for index in folders_index:
    folder = lib_root_folders[index]
    folder_path = os.path.join(lib_path, folder)
    os.makedirs(folder_path)

    if folder == "scripts":
        folder_path = os.path.join(folder_path, "python")
        os.makedirs(folder_path)

# -----------------------------------------------------------------------

# Create the JSON package structure
data = {
    "enable": True,
    "env": [],
    "path": []
}

# Add environment variables
add_env_variable(data["env"], lib_name, os.path.join(lib_dir, lib_name))

# Add path variable
add_path_variable(data["path"], lib_name)

# -----------------------------------------------------------------------

# Define the directory path
directory = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

# Create the directory if it doesn't exist
if not os.path.exists(directory):
    os.makedirs(directory)

# Define the file path
package_path = os.path.join(directory, lib_name + ".json")

# Normalize the path
package_path = os.path.normpath(package_path)

# Write the JSON data to a file
with open(package_path, "w") as f:
    json.dump(data, f, indent=4)]]></script>
  </tool>

  <tool name="dy_restart_houdini" label="Restart Houdini" icon="hicon:/SVGIcons.index?BUTTONS_reload.svg">
    <script scriptType="python"><![CDATA[import os
import platform

# RESTART HOUDINI
if hou.ui.displayMessage("Do you want to restart Houdini?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=0,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):
    
    if platform.system() == 'Windows':
        os.system("taskkill /F /IM houdini.exe && start houdini.exe")
    else:
        print ("The restart feature works only in Windows.\nYou need to restart manually.")]]></script>
