  <tool name="dy_create_lib" label="Create Library" icon="hicon:/SVGIcons.index?BUTTONS_addassetdirectory.svg">
    <script scriptType="python"><![CDATA[# CREATE LIBRARY
import json
import os
import hou
import shutil

# -----------------------------------------------------------------------

def add_env_variable(env_list, key, value):
    env_list.append({key: value})

def add_path_variable(path_list, key):
    path_list.append(f"${key}")

# -----------------------------------------------------------------------

lib_name = hou.ui.readInput(message = "Library Name:",
                       buttons=('OK',),
                       severity=hou.severityType.Message,
                       default_choice=0,
                       close_choice=-1,
                       help=None,
                       title=None,
                       initial_contents=None)[1]

if not lib_name:
    exit()

lib_dir = hou.ui.selectFile(start_directory=None,
                        title=None,
                        collapse_sequences=False,
                        file_type=hou.fileType.Directory,
                        pattern=None,
                        default_value=None,
                        multiple_select=False,
                        image_chooser=None,
                        chooser_mode=hou.fileChooserMode.Read,
                        width=0, height=0)

if not lib_dir:
    exit()

# -----------------------------------------------------------------------

# Define the directory path
lib_path = hou.expandString(os.path.join(lib_dir, lib_name))

# Create the directory if it doesn't exist
if not os.path.exists(lib_path):
    os.makedirs(lib_path)

lib_root_folders = ["config", "examples", "gallery", "otls", "presets", "scripts", "toolbar"]

# Select the variable that defines the library path
folders_index = hou.ui.selectFromList(lib_root_folders,
                             default_choices=(1,3,5,6),
                             exclusive=False,
                             message="Select the variable that defines the library path:",
                             title=None,
                             column_header="Variables",
                             num_visible_rows=10,
                             clear_on_cancel=True,
                             width=0, height=0,
                             sort=False,
                             condense_paths=False)

if not folders_index:
    exit()

# -----------------------------------------------------------------------

# Create library folders
for index in folders_index:
    folder = lib_root_folders[index]
    folder_path = os.path.join(lib_path, folder)
    os.makedirs(folder_path)

    if folder == "scripts":
        folder_path = os.path.join(folder_path, "python")
        os.makedirs(folder_path)

# -----------------------------------------------------------------------

# Create the JSON package structure
data = {
    "enable": True,
    "env": [],
    "hpath": []
}

# Add environment variables
# Check if the package path can be relative to the Houdini packages directory
houdini_packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")
try:
    package_path_rel = os.path.relpath(lib_path, houdini_packages_dir)
    relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
    add_env_variable(data["env"], lib_name, relative_path)
    print(f"Library Path: {relative_path}")
except:
    add_env_variable(data["env"], lib_name, lib_path)
    print(f"Library Path: {lib_path}")

# Add hpath variable
add_path_variable(data["hpath"], lib_name)

# -----------------------------------------------------------------------

# Define the directory path
directory = houdini_packages_dir

# Create the directory if it doesn't exist
if not os.path.exists(directory):
    os.makedirs(directory)

# Define the file path
package_path = os.path.join(directory, lib_name + ".json")

# Normalize the path
package_path = os.path.normpath(package_path)

# Write the JSON data to a file
with open(package_path, "w") as f:
    json.dump(data, f, indent=4)

# Copy the package file to the lib_dir directory
shutil.copy(package_path, lib_path)]]></script>
  </tool>

  <tool name="dy_restart_houdini" label="Restart Houdini" icon="hicon:/SVGIcons.index?BUTTONS_reload.svg">
    <script scriptType="python"><![CDATA[# RESTART HOUDINI
import os
import platform
import hou

# RESTART HOUDINI
#if not platform.system() == 'Windows':
#    print ("The restart feature works only in Windows.\nYou need to restart manually.")
#    exit()

if hou.ui.displayMessage("Do you want to restart Houdini?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=0,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):
    
    if hou.ui.displayMessage("Do you want to open the same file?",
                         buttons=('No', 'Yes'),
                         severity=hou.severityType.ImportantMessage,
                         default_choice=1,
                         close_choice=-1,
                         help=None,
                         title=None,
                         details=None,
                         details_label=None,
                         details_expanded=False,
                         suppress=hou.confirmType.NoConfirmType):

        hip_file_path = hou.hipFile.path()
        if platform.system() == 'Windows':
            os.system(f'taskkill /F /IM houdini.exe && start houdini.exe "{hip_file_path}"')
        else:
            os.system(f'pkill houdini && houdini "{hip_file_path}"')

    else:
        if platform.system() == 'Windows':
            os.system(f'taskkill /F /IM houdini.exe && start houdini.exe')
        else:
            os.system(f'pkill houdini && houdini')]]></script>
  </tool>

  <tool name="dy_copy_prefs" label="Copy Preferences" icon="hicon:/SVGIcons.index?SOP_packedfoldercopy.svg">
    <script scriptType="python"><![CDATA[import hou
import os
import shutil

DIRS = ['asset_store', 'config', 'desktop', 'gallery', 'otls', 'packages', 'radialmenu', 'scripts', 'toolbar', '_PLUGINS']
FILES = [
    'animbar.pref', 'copsettings.json', 'dir.history', 'ExternalEditor.cfg', 'file.history', 'hcommon.pref', 'hotkeys.pref',
    'houdini.env', 'Houdini.keymap.overrides', 'houdini.pref', 'jump.pref',
    'networkeditor.pref', 'nodethemes.json', 'opencl.pref', 'solaris.pref', 'ui.pref', 'redshift30_rv.json'
]
DEFAULT_SEL = [
    'desktop', 'otls', 'packages', 'radialmenu', 'scripts', 'toolbar', '_PLUGINS',
    'houdini.pref', 'jump.pref', 'networkeditor.pref', 'nodethemes.json', 'ui.pref'
]
PREFS_DIR = None

# ----------------------------------------------------------------

def prompt_prefs_dir():
    """Ask user for source preferences directory and expand Houdini variables."""
    button, value = hou.ui.readInput(
        message="Preferences Directory:",
        buttons=("OK", "Cancel"),
        severity=hou.severityType.Message,
        default_choice=0,
        close_choice=1,
        title="Houdini",
        initial_contents="$HOUDINI_USER_PREF_DIR",
    )

    if button != 0:
        return None

    value = (value or "").strip()
    if not value:
        return None

    return os.path.normpath(hou.expandString(value))

def get_existing_items(items, is_dir=True):
    """Filter items that exist in the preferences directory."""
    check = os.path.isdir if is_dir else os.path.isfile
    return [item for item in items if check(os.path.join(PREFS_DIR, item))]

def select_items(items, is_dir=True):
    """Show selection dialog for directories or files."""
    existing = get_existing_items(items, is_dir)
    item_type = "directories" if is_dir else "files"
    
    if not existing:
        hou.ui.displayMessage(f"No {item_type} found in preferences folder.", title="Migration Tool")
        return []
    
    indices = hou.ui.selectFromList(
        choices=existing,
        default_choices=tuple(i for i, name in enumerate(existing) if name in DEFAULT_SEL),
        message=f"Select {item_type} to migrate from:\n{PREFS_DIR}",
        title=f"Select {item_type.title()}",
        column_header=item_type.title(),
        num_visible_rows=15,
        clear_on_cancel=True,
    )
    return [existing[i] for i in indices] if indices else []

def select_target_directory():
    """Select target directory using file chooser."""
    target = hou.ui.selectFile(
        start_directory=os.path.dirname(PREFS_DIR).replace("\\", "/"),
        title="Select Target Preferences Directory",
        file_type=hou.fileType.Directory,
        chooser_mode=hou.fileChooserMode.ReadAndWrite,
    )
    if target:
        return os.path.normpath(hou.text.expandString(target))
    return None

def copy_item(src, dst):
    """Copy file or directory, merging if destination exists."""
    if os.path.isdir(src):
        shutil.copytree(src, dst, dirs_exist_ok=True)
    else:
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        shutil.copy2(src, dst)

def migrate_preferences():
    """Main migration workflow."""
    global PREFS_DIR
    PREFS_DIR = prompt_prefs_dir()

    if not PREFS_DIR:
        hou.ui.displayMessage("No source preferences directory provided.", title="Migration Cancelled")
        return

    if not os.path.isdir(PREFS_DIR):
        hou.ui.displayMessage(f"Preferences directory not found:\n{PREFS_DIR}",
                              severity=hou.severityType.Error, title="Copy Error")
        return

    # Copy start message
    #hou.ui.displayMessage(f"Copying preferences from:\n{PREFS_DIR}\n\n"
    #                      "You will now select directories, files, and target location.",
    #                      title="Copy Preferences")

    # Select directories
    selected_dirs = select_items(DIRS, is_dir=True)
    if not selected_dirs:
        hou.ui.displayMessage(
            "Copy cancelled: no directories selected.",
            title="Copy Cancelled"
        )
        return

    # Select files
    selected_files = select_items(FILES, is_dir=False)
    if not selected_files:
        hou.ui.displayMessage(
            "Copy cancelled: no files selected.",
            title="Copy Cancelled"
        )
        return

    target_dir = select_target_directory()
    if not target_dir:
        hou.ui.displayMessage("No target directory selected.", title="Copy Cancelled")
        return

    if os.path.normpath(target_dir) == os.path.normpath(PREFS_DIR):
        hou.ui.displayMessage("Target cannot be the same as source.",
                              severity=hou.severityType.Error, title="Copy Error")
        return

    # Confirmation
    dirs_str = ', '.join(selected_dirs) if selected_dirs else 'None'
    files_str = ', '.join(selected_files) if selected_files else 'None'
    confirm_msg = (f"Directories ({len(selected_dirs)}): {dirs_str}\n\n"
                   f"Files ({len(selected_files)}): {files_str}\n\n"
                   f"From: {PREFS_DIR}\nTo: {target_dir}\n\n"
                   f"Existing items will be overwritten/merged. Continue?")
    
    if not hou.ui.displayConfirmation(confirm_msg, title="Confirm Copy"):
        return

    # Perform copy
    all_items = [(d, True) for d in selected_dirs] + [(f, False) for f in selected_files]
    total = len(all_items)
    errors, copied = [], 0

    try:
        with hou.InterruptableOperation("Copy Preferences",
                                        long_operation_name="Copying",
                                        open_interrupt_dialog=True) as op:
            for i, (name, is_dir) in enumerate(all_items):
                item_type = "directory" if is_dir else "file"
                op.updateLongProgress(i / total, f"Copying {item_type}: {name}")
                
                try:
                    copy_item(os.path.join(PREFS_DIR, name), os.path.join(target_dir, name))
                    copied += 1
                except Exception as e:
                    errors.append(f"{item_type.title()} '{name}': {e}")
                
                op.updateProgress((i + 1) / total)

    except hou.OperationInterrupted:
        hou.ui.displayMessage(f"Cancelled. Copied {copied}/{total} items.",
                              severity=hou.severityType.Warning, title="Copy Cancelled")
        return

    # Result
    if errors:
        hou.ui.displayMessage(f"Completed with {len(errors)} error(s). Copied: {copied} items",
                              severity=hou.severityType.Warning,
                              title="Copy Complete (with errors)",
                              details="\n".join(errors), details_label="Show Errors")
    else:
        hou.ui.displayMessage(f"Successfully copied {copied} items to:\n{target_dir}",
                              title="Copy Complete")

# ----------------------------------------------------------------

migrate_preferences()]]></script>
  </tool>

  <tool name="dy_lib_manager" label="dy Library Manager" icon="hicon:/SVGIcons.index?SHELF_asset_library.svg">
    <script scriptType="python"><![CDATA[# dy Library Manager
import hou
import os
import json
import subprocess
import platform
import webbrowser
import glob
import shutil
import stat
import urllib.request
import ssl
from datetime import datetime
from pathlib import Path

try:
    from PySide6 import QtWidgets, QtCore, QtGui  # H21+
except ModuleNotFoundError:
    from PySide2 import QtWidgets, QtCore, QtGui  # H20.5-

# -----------------------------------------------------------------------
# CONSTANTS
# -----------------------------------------------------------------------

TITLE_LIB = "dy Library Manager"
DB_FILENAME = "dy_lib_manager_db.json"
DB_REMOTE_URL = f"https://raw.githubusercontent.com/cdordelly/dyLib/dev/{DB_FILENAME}"
HELP_URL = "https://dub.sh/dy_lm_help"
IS_WINDOWS = platform.system() == "Windows"
SUBPROCESS_FLAGS = {"creationflags": subprocess.CREATE_NO_WINDOW} if IS_WINDOWS else {}
SHOW_SHELF_TOOLS = False

# -----------------------------------------------------------------------
# ICONS
# -----------------------------------------------------------------------

ICON_SEARCH = "BUTTONS_search"
ICON_SEARCH_CLEAR = "BUTTONS_remove"
ICON_REFRESH = "BUTTONS_cook"
ICON_FILTER = "BUTTONS_filter"
ICON_FOLDER = "BUTTONS_folder"
ICON_DOWNLOAD = "BUTTONS_auto_save"
ICON_REDOWNLOAD = "MISC_database"
ICON_FAVORITE = "BUTTONS_favorites"
ICON_TAG = "BUTTONS_tag"
ICON_LINK = "VIEW_visualization_global"
ICON_INSTALL_JSON = "DESKTOP_installer"
ICON_INSTALL_LIB = "DESKTOP_installer2"
ICON_INSTALL_GITHUB = "BUTTONS_download"
ICON_HELP = "BUTTONS_help"

HIGHLIGHT_COLOR = "rgba(255, 170, 0, 80)"
HIGHLIGHT_COLOR_HOVER = "rgba(255, 170, 0, 120)"
TOOLBTN_STYLE = "QToolButton { border: none; padding: 2px; } QToolButton:hover { background-color: rgba(255, 255, 255, 30); }"

# -----------------------------------------------------------------------
# PATH HELPER
# -----------------------------------------------------------------------

def _fwd_path(p):
    return os.path.normpath(p).replace("\\", "/")

# -----------------------------------------------------------------------
# GIT UTILITY FUNCTIONS
# -----------------------------------------------------------------------

def is_git_installed():
    try:
        subprocess.run(["git", "--version"], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE, **SUBPROCESS_FLAGS)
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False

def get_remote_branches(repository_url):
    result = subprocess.run(["git", "ls-remote", "--heads", repository_url], capture_output=True, text=True, **SUBPROCESS_FLAGS)
    branches = [line.split("refs/heads/")[1].strip() for line in result.stdout.splitlines() if "refs/heads/" in line]
    return branches

def get_remote_releases(url):
    try:
        owner, repo = parse_owner_repo(url)
        api_url = f"https://api.github.com/repos/{owner}/{repo}/releases"
        req = urllib.request.Request(api_url, headers={"Accept": "application/vnd.github.v3+json"})
        with _urlopen_with_ssl_fallback(req, timeout=10) as response:
            releases_data = json.loads(response.read().decode("utf-8"))
            releases = []
            for release in releases_data:
                release_name = release.get("name") or release.get("tag_name")
                tag_name = release.get("tag_name")
                releases.append((release_name, tag_name))
            return releases
    except Exception as e:
        print(f"Error fetching releases: {e}")
        return get_remote_tags(url)

def get_remote_tags(repository_url):
    result = subprocess.run(["git", "ls-remote", "--tags", repository_url], capture_output=True, text=True, **SUBPROCESS_FLAGS)
    tags = [(line.split("refs/tags/")[1].strip(), line.split("refs/tags/")[1].strip())
            for line in result.stdout.splitlines()
            if "^{}" not in line and "refs/tags/" in line]
    return tags

def download_github_repository(url, destination, ref="master", is_release=False):
    if is_release:
        subprocess.run(["git", "clone", "--depth", "1", "--branch", ref, url, destination], **SUBPROCESS_FLAGS)
    else:
        subprocess.run(["git", "clone", "-b", ref, url, destination], **SUBPROCESS_FLAGS)

def git_pull(directory):
    subprocess.run(["git", "pull"], cwd=directory, **SUBPROCESS_FLAGS)

def git_checkout(directory, ref):
    subprocess.run(["git", "fetch", "--all"], cwd=directory, **SUBPROCESS_FLAGS)
    subprocess.run(["git", "checkout", ref], cwd=directory, **SUBPROCESS_FLAGS)

# -----------------------------------------------------------------------
# GITHUB API HELPER
# -----------------------------------------------------------------------

def parse_owner_repo(url):
    parts = url.split("github.com/")
    if len(parts) < 2:
        return None, None
    owner_repo = parts[1].replace(".git", "").strip("/")
    segments = owner_repo.split("/")
    if len(segments) >= 2:
        return segments[0], segments[1]
    return None, None

def get_repo_info_from_entry(lib_entry):
    url = lib_entry.get("url", "")
    fallback_name = Path(url).stem if url else "Unknown"
    return {
        "name": lib_entry.get("name") or fallback_name,
        "description": lib_entry.get("description") or "",
        "author": lib_entry.get("author") or "",
        "url": url.replace(".git", "").rstrip("/")
    }

# -----------------------------------------------------------------------
# DATABASE LOADING
# -----------------------------------------------------------------------

def _urlopen_with_ssl_fallback(url, timeout=15):
    try:
        return urllib.request.urlopen(url, timeout=timeout)
    except urllib.error.URLError as e:
        if "CERTIFICATE_VERIFY_FAILED" in str(e) or "SSL" in str(e):
            print(f"SSL verification failed, retrying without verification...")
            ctx = ssl.create_default_context()
            ctx.check_hostname = False
            ctx.verify_mode = ssl.CERT_NONE
            return urllib.request.urlopen(url, timeout=timeout, context=ctx)
        raise

def load_database():
    local_path = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), DB_FILENAME)
    if os.path.isfile(local_path):
        try:
            with open(local_path, "r") as f:
                data = json.load(f)
            if isinstance(data, dict) and "libraries" in data:
                return data
            print(f"Local database is invalid or incomplete, re-downloading...")
            os.remove(local_path)
        except Exception as e:
            print(f"Local database could not be read ({e}), re-downloading...")
            try:
                os.remove(local_path)
            except Exception:
                pass
    # Download from remote
    try:
        print(f"Downloading library database from: {DB_REMOTE_URL}")
        with _urlopen_with_ssl_fallback(DB_REMOTE_URL, timeout=15) as response:
            data = json.loads(response.read().decode("utf-8"))
            os.makedirs(os.path.dirname(local_path), exist_ok=True)
            with open(local_path, "w") as f:
                json.dump(data, f, indent=2)
            print(f"Database saved to: {_fwd_path(local_path)}")
            return data
    except Exception as e:
        print(f"Error downloading database: {e}")
        return None

def save_local_setting(key, value):
    local_path = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), DB_FILENAME)
    try:
        data = {}
        if os.path.isfile(local_path):
            with open(local_path, "r") as f:
                data = json.load(f)
        data[key] = value
        with open(local_path, "w") as f:
            json.dump(data, f, indent=2)
    except Exception as e:
        print(f"Error saving setting '{key}': {e}")

# -----------------------------------------------------------------------
# PACKAGE UTILITY FUNCTIONS
# -----------------------------------------------------------------------

def add_env_variable(env_list, key, value):
    env_list.append({key: value})

def add_path_variable(path_list, key):
    path_list.append(f"${key}")

def hou_reload_packages(lib_name, package_path):
    print(f"Installing: {lib_name}")
    sep = "----------------"
    print(f"{sep} Packages reload START {sep}")
    print(
        "Houdini's packages are reloading, wait until Houdini finish the reload process.\n\n"
        "This will reload: Desktops, Digital Assets, Python modules, Python panels, Shelf tools, Viewer states, Viewer handles.\n"
    )
    try:
        with hou.InterruptableOperation("Reloading Houdini Packages", open_interrupt_dialog=True) as operation:
            print(f"Loading package: {_fwd_path(package_path)}")
            hou.ui.loadPackage(package_path)
            operation.updateProgress(1.0)
    except Exception as e:
        print(f"An error occurred: {e}")
    print(f"{sep} Packages reload END {sep}")
    print("The packages reload process is finished.")

# -----------------------------------------------------------------------
# STATUS DETECTION
# -----------------------------------------------------------------------

def get_repo_name(url):
    return Path(url).stem

def get_library_status(repo_name, packages_dir, install_root=None, create_package=True):
    if not create_package and install_root:
        expanded_root = hou.expandString(install_root)
        lib_dir = os.path.join(expanded_root, repo_name)
        if os.path.isdir(lib_dir):
            return "Installed", True, ""
        return "Not Installed", False, ""

    package_path = os.path.join(packages_dir, repo_name + ".json")
    if not os.path.isfile(package_path):
        return "Not Installed", False, package_path
    try:
        with open(package_path, "r") as f:
            data = json.load(f)
        enabled = data.get("enable", True)
        status = "Installed" if enabled else "Disabled"
        return status, enabled, package_path
    except Exception:
        return "Unknown", False, package_path

def resolve_unique_names(entries):
    name_counts = {}
    for entry in entries:
        name = entry["repo_name"]
        name_counts[name] = name_counts.get(name, 0) + 1
    for entry in entries:
        if name_counts[entry["repo_name"]] > 1:
            owner, _ = parse_owner_repo(entry["db"]["url"])
            if owner:
                entry["repo_name"] = f"{owner}-{entry['repo_name']}"

def _create_basic_package(lib_dir, package_key, houdini_packages_dir):
    data = {"enable": True, "env": [], "hpath": []}
    try:
        package_path_rel = os.path.relpath(lib_dir, houdini_packages_dir)
        relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
        add_env_variable(data["env"], package_key, relative_path)
    except Exception:
        add_env_variable(data["env"], package_key, lib_dir)
    add_path_variable(data["hpath"], package_key)
    return data

# -----------------------------------------------------------------------
# INSTALL LOGIC
# -----------------------------------------------------------------------

def install_library(lib_entry, install_root, repo_name, ref, is_release=False):
    url = lib_entry["url"]
    package_file = lib_entry.get("package_file")
    package_key = lib_entry.get("package_key") or repo_name.replace("-", "_")

    expanded_root = hou.expandString(install_root)
    lib_dir = os.path.join(expanded_root, repo_name)

    if os.path.isdir(lib_dir):
        print(f"Directory already exists: {lib_dir}")
        return False

    # Clone repository
    lib_dir_display = _fwd_path(lib_dir)
    print(f"Cloning {url} ({ref}) to {lib_dir_display}")
    try:
        with hou.InterruptableOperation(f"Downloading {repo_name}", open_interrupt_dialog=True) as operation:
            download_github_repository(url, lib_dir, ref, is_release)
            operation.updateProgress(1.0)
    except hou.OperationInterrupted:
        if os.path.isdir(lib_dir):
            shutil.rmtree(lib_dir, onerror=_remove_readonly)
        print(f"Download cancelled: {repo_name}")
        return False

    if not os.path.isdir(lib_dir):
        print(f"Clone failed: {lib_dir_display} not found")
        return False

    # Skip package creation if create_package is false
    if not lib_entry.get("create_package", True):
        print(f"Clone-only mode: no package created for {repo_name}")
        return True

    houdini_packages_dir = os.path.join(hou.getenv("HOUDINI_USER_PREF_DIR"), "packages")

    # Resolve effective library directory (subfolder support via lib_location)
    lib_location = lib_entry.get("lib_location", "")
    effective_lib_dir = os.path.join(lib_dir, lib_location) if lib_location else lib_dir

    # Search for the package file if one is specified in the DB
    found_files = []
    if package_file:
        found_files = glob.glob(os.path.join(lib_dir, "**", package_file), recursive=True)
        if not found_files:
            root_file = os.path.join(lib_dir, package_file)
            if os.path.isfile(root_file):
                found_files = [root_file]

    if found_files:
        source_package_path = os.path.normpath(found_files[0])
        try:
            with open(source_package_path, "r") as f:
                data = json.load(f)
        except Exception:
            print(f"Failed to parse {source_package_path}, creating basic package.")
            data = None

        if data and "env" in data:
            package_dir = os.path.dirname(source_package_path)
            # Use lib_location subfolder if the package file is at repo root
            if lib_location and package_dir == lib_dir:
                package_dir = effective_lib_dir
            for env_dict in data["env"]:
                if package_key in env_dict:
                    try:
                        package_path_rel = os.path.relpath(package_dir, houdini_packages_dir)
                        relative_path = "$HOUDINI_PACKAGE_PATH/" + package_path_rel.replace("\\", "/")
                        env_dict[package_key] = relative_path
                        print(f"Library Path: {relative_path}")
                    except Exception:
                        env_dict[package_key] = package_dir
                        print(f"Library Path: {package_dir}")
                    break
            # Ensure "enable" is the first key
            if "enable" not in data:
                data = {"enable": True, **data}
            else:
                data = {"enable": data.pop("enable"), **data}
        else:
            data = _create_basic_package(effective_lib_dir, package_key, houdini_packages_dir)
    else:
        if package_file:
            print(f"Package file '{package_file}' not found, creating basic package.")
        else:
            print(f"No package file specified, creating basic package.")
        data = _create_basic_package(effective_lib_dir, package_key, houdini_packages_dir)

    # Save package to Houdini packages dir
    os.makedirs(houdini_packages_dir, exist_ok=True)
    dest_package_path = os.path.normpath(os.path.join(houdini_packages_dir, repo_name + ".json"))
    with open(dest_package_path, "w") as f:
        json.dump(data, f, indent=4)

    # Reload Houdini packages
    hou_reload_packages(repo_name, dest_package_path)
    return True

# -----------------------------------------------------------------------
# ENABLE / DISABLE
# -----------------------------------------------------------------------

def set_library_enabled(repo_name, packages_dir, enabled):
    package_path = os.path.join(packages_dir, repo_name + ".json")
    if not os.path.isfile(package_path):
        return False
    try:
        with open(package_path, "r") as f:
            data = json.load(f)
        # Rebuild with "enable" as the first key
        new_data = {"enable": enabled}
        for key, value in data.items():
            if key != "enable":
                new_data[key] = value
        with open(package_path, "w") as f:
            json.dump(new_data, f, indent=4)
        return True
    except Exception as e:
        print(f"Error toggling {repo_name}: {e}")
        return False

# -----------------------------------------------------------------------
# UNINSTALL
# -----------------------------------------------------------------------

def _remove_readonly(func, path, excinfo):
    os.chmod(path, stat.S_IWRITE)
    func(path)

def uninstall_library(repo_name, install_root, packages_dir):
    expanded_root = hou.expandString(install_root)
    lib_dir = os.path.join(expanded_root, repo_name)
    package_path = os.path.join(packages_dir, repo_name + ".json")
    removed = False
    if os.path.isdir(lib_dir):
        shutil.rmtree(lib_dir, onerror=_remove_readonly)
        print(f"Removed directory: {_fwd_path(lib_dir)}")
        removed = True
    if os.path.isfile(package_path):
        os.remove(package_path)
        print(f"Removed package: {_fwd_path(package_path)}")
        removed = True
    return removed

# -----------------------------------------------------------------------
# UI DIALOG
# -----------------------------------------------------------------------

COL_ENABLE = 0
COL_NAME = 1
COL_DESCRIPTION = 2
COL_AUTHOR = 3
COL_ACTION = 4
COLUMN_LABELS = ["", "Library", "Description", "Author", ""]

class _CenteredIconDelegate(QtWidgets.QStyledItemDelegate):
    def paint(self, painter, option, index):
        icon = index.data(QtCore.Qt.DecorationRole)
        if icon and not icon.isNull():
            # Draw default background (selection, alternating rows)
            opt = QtWidgets.QStyleOptionViewItem(option)
            self.initStyleOption(opt, index)
            opt.icon = QtGui.QIcon()
            opt.text = ""
            style = opt.widget.style() if opt.widget else QtWidgets.QApplication.style()
            style.drawControl(QtWidgets.QStyle.CE_ItemViewItem, opt, painter, opt.widget)
            # Draw subtle rounded background behind icon
            icon_size = opt.decorationSize
            ix = option.rect.x() + (option.rect.width() - icon_size.width()) // 2
            iy = option.rect.y() + (option.rect.height() - icon_size.height()) // 2
            bg_rect = QtCore.QRect(ix - 4, iy - 4, icon_size.width() + 8, icon_size.height() + 8)
            painter.save()
            painter.setRenderHint(QtGui.QPainter.Antialiasing)
            painter.setBrush(QtGui.QColor(255, 255, 255, 20))
            painter.setPen(QtCore.Qt.NoPen)
            painter.drawRoundedRect(bg_rect, 4, 4)
            painter.restore()
            # Draw icon centered
            icon.paint(painter, ix, iy, icon_size.width(), icon_size.height())
        else:
            super().paint(painter, option, index)

class _Table(QtWidgets.QTableWidget):
    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.viewport().setMouseTracking(True)
        self.verticalScrollBar().installEventFilter(self)
        self.horizontalScrollBar().installEventFilter(self)

    def viewportEvent(self, event):
        # Block hover events on the viewport — prevents QAbstractItemView
        # from clearing/changing its hover-index when the cursor moves onto
        # a setCellWidget child, the scrollbar, or outside the table.
        if event.type() in (QtCore.QEvent.HoverLeave,
                            QtCore.QEvent.HoverEnter,
                            QtCore.QEvent.HoverMove):
            return True
        return super().viewportEvent(event)

    def eventFilter(self, obj, event):
        # Forward scrollbar MouseMove events to the viewport so the hover
        # position stays current while the cursor is over a scrollbar.
        if obj in (self.verticalScrollBar(), self.horizontalScrollBar()):
            if event.type() == QtCore.QEvent.MouseMove:
                global_pos = obj.mapToGlobal(event.pos())
                local_pos  = self.viewport().mapFromGlobal(global_pos)
                try:
                    new_event = QtGui.QMouseEvent(
                        event.type(),
                        QtCore.QPointF(local_pos),
                        QtCore.QPointF(global_pos),
                        event.button(), event.buttons(), event.modifiers()
                    )
                except TypeError:
                    new_event = QtGui.QMouseEvent(
                        event.type(), local_pos,
                        event.button(), event.buttons(), event.modifiers()
                    )
                QtWidgets.QApplication.sendEvent(self.viewport(), new_event)
                return False
        return super().eventFilter(obj, event)

